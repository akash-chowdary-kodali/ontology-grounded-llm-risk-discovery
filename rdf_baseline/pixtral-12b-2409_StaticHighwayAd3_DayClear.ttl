### **2. Scene Description in RDF Triples (Turtle Format)**
```turtle
@prefix ex: <http://example.org/autonomous-driving#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

ex:Scene1 a ex:IntersectionScene ;
    ex:hasWeatherCondition ex:ClearWeather ;
    ex:hasRoadMarking ex:LaneDivisions, ex:TurnArrows ;
    ex:hasTrafficLight [
        a ex:TrafficLight ;
        ex:signalColorForDirection ex:Green, ex:Red ;
        ex:appliesToDirection ex:LeftTurn, ex:RightTurn, ex:Straight
    ] ;
    ex:hasTrafficSign [
        a ex:TrafficSign ;
        ex:type ex:NoEntry ;
        ex:appliesToDirection ex:OppositeLane
    ], [
        a ex:TrafficSign ;
        ex:type ex:SpeedLimit ;
        ex:value "90"^^xsd:integer ;
        ex:unit ex:KilometersPerHour
    ], [
        a ex:TrafficSign ;
        ex:type ex:PedestrianCrossing
    ] ;
    ex:hasInfrastructure ex:BusStop, ex:Sidewalk, ex:BrickWall, ex:OverheadBridge ;
    ex:hasEgoVehicle ex:RedCar ;
    ex:hasPotentialRisk ex:UnsignalizedPedestrianCrossingRisk, ex:MisinterpretedTrafficLightRisk .

ex:RedCar a ex:Vehicle ;
    ex:position ex:ApproachingIntersection ;
    ex:hasFieldOfView ex:Clear .

ex:BusStop a ex:Infrastructure ;
    ex:location ex:RightSideOfRoad .

ex:OverheadBridge a ex:Infrastructure ;
    ex:location ex:Background .
```

