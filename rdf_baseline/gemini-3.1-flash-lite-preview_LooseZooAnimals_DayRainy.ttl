ex:EgoVehicle ex:isLocatedOn ex:Road .
ex:Gorilla_1 ex:isLocatedOn ex:Road ;
             ex:isNear ex:EgoVehicle .
ex:Gorilla_2 ex:isLocatedOn ex:Road ;
             ex:isAheadOf ex:Gorilla_1 .
ex:ElephantStatue ex:isNear ex:Road ;
                  ex:isStatic true .
ex:Deer ex:isLocatedOn ex:GrassVerge .
ex:Environment ex:hasWeather ex:Rainy ;
               ex:hasVisibility ex:Low .
```

