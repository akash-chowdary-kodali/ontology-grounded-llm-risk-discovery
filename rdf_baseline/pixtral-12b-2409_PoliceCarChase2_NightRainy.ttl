ex:Scene1 a ex:AutonomousDrivingScene ;
    ex:hasWeatherCondition ex:WetRoad ;
    ex:hasRoadMarking ex:DoubleYellowLine, ex:WhiteLaneMarking ;
    ex:hasInfrastructure ex:BridgeStructure, ex:TrafficSign .

ex:EgoVehicle a ex:Vehicle ;
    ex:hasColor "red" ;
    ex:isFollowing ex:BlackSedan ;
    ex:isInLane ex:CenterLane ;
    ex:hasHoodObstruction true .

ex:BlackSedan a ex:Vehicle ;
    ex:hasColor "black" ;
    ex:isAheadOf ex:EgoVehicle ;
    ex:isInLane ex:CenterLane .

