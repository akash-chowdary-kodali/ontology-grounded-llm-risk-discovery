    ex:hasColor "white" ;
    ex:isInLane ex:RightLane ;
    ex:isNear ex:EgoVehicle .

ex:BridgeStructure a ex:RoadInfrastructure ;
    ex:isOverhead true ;
    ex:causesOcclusion true .

ex:TrafficSign a ex:RoadInfrastructure ;
    ex:isNear ex:RightEdge ;
