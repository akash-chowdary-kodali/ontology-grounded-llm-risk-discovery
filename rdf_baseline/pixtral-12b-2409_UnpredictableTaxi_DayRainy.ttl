ex:HeavyRain a ex:WeatherCondition ;
    ex:hasIntensity "High" ;
    ex:affectsVisibility "Severe" .

ex:ReducedVisibility a ex:WeatherCondition ;
    ex:hasCause ex:HeavyRain ;
    ex:hasEffect "Occlusion of distant objects" .

ex:YellowTaxi a ex:Vehicle ;
    ex:hasColor "Yellow" ;
    ex:isPositionedInLane "Left" ;
    ex:isApproaching ex:CameraVehicle .

ex:CameraVehicle a ex:Vehicle ;
    ex:hasColor "Red" ;
    ex:isFollowing ex:YellowTaxi ;
    ex:isPositionedInLane "Left" .

ex:DistantRedVehicle a ex:Vehicle ;
    ex:hasColor "Red" ;
    ex:isPositionedInLane "Right" ;
    ex:isTravelingInDirection "Opposite" .

ex:RoadSurface a ex:RoadInfrastructure ;
    ex:hasCondition "Wet" ;
    ex:hasLaneMarkings "Visible" .

ex:Sidewalk a ex:RoadInfrastructure ;
    ex:hasPotentialPedestrians "Unseen" ;
    ex:isOccludedBy ex:ReducedVisibility .

ex:TrafficLight a ex:RoadInfrastructure ;
    ex:isOccludedBy ex:ReducedVisibility .

ex:Risk1 a ex:SafetyRisk ;
    ex:riskType ex:CollisionRisk ;
    ex:riskDescription "High risk of rear-end collision due to reduced visibility and following distance" ;
    ex:severityScore 0.85 .

ex:Risk2 a ex:SafetyRisk ;
    ex:riskType ex:PedestrianCollisionRisk ;
    ex:riskDescription "Potential unseen pedestrians on sidewalk due to poor visibility" ;
    ex:severityScore 0.75 .

ex:Risk3 a ex:SafetyRisk ;
    ex:riskType ex:LaneDepartureRisk ;
    ex:riskDescription "Risk of unintended lane change due to obscured lane markings" ;
    ex:severityScore 0.65 .
```

