    ex:hasLightingCondition ex:ArtificialLighting ;
    ex:hasWeatherCondition ex:ClearIndoor .

ex:EgoVehicle a ex:Vehicle ;
    ex:hasColor "Red" ;
    ex:isPositionedIn ex:LeftLane ;
    ex:hasFieldOfViewOcclusion ex:StructuralBeams .

ex:VehicleA a ex:Vehicle ;
    ex:hasColor "Black" ;
    ex:isPositionedIn ex:LeftLane ;
    ex:isApproaching ex:EgoVehicle ;
    ex:hasPotentialAction ex:LaneChange .

ex:VehicleB a ex:Vehicle ;
    ex:hasColor "White" ;
    ex:isPositionedIn ex:RightLane ;
    ex:isApproaching ex:EgoVehicle ;
    ex:hasPotentialAction ex:Merge .

ex:StructuralBeams a ex:Obstacle ;
    ex:isPartOf ex:ParkingGarageStructure ;
    ex:causesOcclusion ex:EgoVehicle .

ex:ConcretePillars a ex:Obstacle ;
    ex:isPartOf ex:ParkingGarageStructure ;
    ex:causesBlindSpot ex:EgoVehicle .

