    :hasAction :Crossing ;
    :hasAppearance :BlurredMotion .

:Pedestrian2 a :Pedestrian ;
    :hasPosition "crosswalk, center of road" ;
    :hasAction :Crossing ;
    :hasAppearance :BlurredMotion ;
    :hasRelativePositionTo :Pedestrian1 "near" .

:Vehicle1 a :Vehicle ;
    :hasPosition "view from inside, front seat" ;
    :hasAction :ApproachingCrosswalk .

:Building1 a :Building ;
    :hasPosition "left side of road" ;
    :hasType :Residential .

:Building2 a :Building ;
    :hasPosition "right side of road" ;
    :hasType :Commercial .

:TrafficLight1 a :TrafficLight ;
    :hasPosition "ahead on road" ;
    :hasSignal :Red .

:StreetLight1 a :StreetLight ;
    :hasPosition "alongside road" ;
    :hasCondition :On .

:Vehicle1 :hasRelationshipWith :Pedestrian1 :Approaching .
:Vehicle1 :hasRelationshipWith :Pedestrian2 :Approaching .
