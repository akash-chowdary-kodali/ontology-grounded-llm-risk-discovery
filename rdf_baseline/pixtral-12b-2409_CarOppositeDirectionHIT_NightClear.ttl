    ex:hasType "DoubleWhiteLines" ;
    ex:hasType "DashedLines" .

ex:OverheadStructure a ex:RoadInfrastructure ;
    ex:hasMaterial "WoodenBeams" ;
    ex:occludes ex:Motorcycle .

ex:Streetlight a ex:RoadInfrastructure ;
    ex:illuminates ex:Motorcycle ;
    ex:illuminates ex:RoadMarkings .

