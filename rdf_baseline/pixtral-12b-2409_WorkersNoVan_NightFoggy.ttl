ex:Scene1 a ex:AutonomousDrivingScene ;
    ex:hasEntity ex:Pedestrian1, ex:Vehicle1, ex:TrafficCone1, ex:TrafficCone2, ex:Streetlight1, ex:RoadMarking1 ;
    ex:hasEnvironmentalCondition ex:Nighttime, ex:FoggyConditions .

ex:Pedestrian1 a ex:Pedestrian ;
    ex:hasLocation ex:RoadCrossingZone ;
    ex:hasAction ex:CrossingRoad ;
    ex:hasAppearance "Yellow shirt, blue jeans" ;
    ex:hasTrajectory ex:MovingRight .

ex:Vehicle1 a ex:AutonomousVehicle ;
    ex:hasLocation ex:ApproachingPedestrian ;
    ex:hasViewpoint ex:FrontCamera ;
    ex:hasAction ex:FollowingPedestrian .

ex:TrafficCone1 a ex:Obstacle ;
    ex:hasLocation ex:RoadSurface ;
    ex:hasColor "Orange" ;
    ex:isNear ex:Pedestrian1 .

ex:TrafficCone2 a ex:Obstacle ;
    ex:hasLocation ex:RoadSurface ;
    ex:hasColor "Orange" .

ex:Streetlight1 a ex:LightSource ;
    ex:illuminates ex:Pedestrian1, ex:TrafficCone1, ex:TrafficCone2 ;
    ex:hasCondition ex:LowVisibilityDueToFog .

ex:RoadMarking1 a ex:RoadInfrastructure ;
    ex:hasType "LaneLine" .

ex:Nighttime a ex:EnvironmentalCondition ;
    ex:reducesVisibility .

ex:FoggyConditions a ex:EnvironmentalCondition ;
    ex:reducesVisibility ;
    ex:affects ex:Streetlight1 .
```

