@prefix ex: <http://example.org/autonomous-driving#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Scene1 a ex:AutonomousDrivingScene ;
    ex:hasLightingCondition ex:LowLighting ;
    ex:hasWeatherCondition ex:WetRoadWithReflections ;
    ex:hasTimeOfDay ex:Night .

ex:EgoVehicle a ex:Vehicle ;
    ex:hasColor "Red" ;
    ex:isApproaching ex:StationaryVehicle ;
    ex:hasSensorInterference ex:GlareFromReflections .

