    ex:hasColor "Black" ;
    ex:isOccludedBy ex:OverheadStructure ;
    ex:isPositionedIn ex:Alleyway .

ex:OverheadStructure a ex:RoadInfrastructure ;
    ex:spans ex:Alleyway ;
    ex:occludes ex:StationaryVehicle .

ex:Alleyway a ex:Road ;
    ex:hasRoadMarkings ex:WhiteDashedLines ;
    ex:hasSurfaceCondition ex:Wet .

ex:Risk1 a ex:SafetyRisk ;
    ex:riskType ex:CollisionWithStationaryVehicle ;
    ex:severity 0.85 ;
    ex:dueTo ex:LowVisibility, ex:SensorInterference .

ex:Risk2 a ex:SafetyRisk ;
    ex:riskType ex:SensorFailureDueToReflections ;
    ex:severity 0.75 ;
    ex:dueTo ex:WetRoadWithGlare .

ex:Risk3 a ex:SafetyRisk ;
    ex:riskType ex:PathObstruction ;
    ex:severity 0.6 ;
    ex:dueTo ex:StationaryVehicle .
```

