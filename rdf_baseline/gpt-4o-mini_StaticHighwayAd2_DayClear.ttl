### Scene Description in RDF Triples (Turtle Format)

```turtle
@prefix ex: <http://example.org/> .

ex:scene1 a ex:TrafficScene ;
    ex:hasEntity ex:Vehicle1, ex:Billboard1, ex:TrafficLight1, ex:RoadSign1, ex:Tree1 ;
    ex:hasRoadInfrastructure ex:Road1, ex:Sidewalk1 ;
    ex:hasWeatherCondition ex:ClearWeather .

ex:Vehicle1 a ex:Vehicle ;
    ex:hasType ex:Car ;
    ex:isNear ex:Road1 .

ex:Billboard1 a ex:Advertisement ;
    ex:hasContent "Are you hungry? Try dinner!" .

ex:TrafficLight1 a ex:Signal ;
    ex:hasState "Green" .

ex:RoadSign1 a ex:Sign ;
    ex:hasType ex:SpeedLimit ;
    ex:hasValue "30 mph" ;
    ex:isNear ex:Road1 .

ex:Tree1 a ex:Plant ;
    ex:isNear ex:Sidewalk1 .

ex:Road1 a ex:Road ;
    ex:hasLanes "4" ;
    ex:hasSurface "Paved" .

ex:Sidewalk1 a ex:Infrastructure ;
    ex:hasType ex:Sidewalk ;
    ex:isAdjacentTo ex:Road1 .

ex:ClearWeather a ex:WeatherCondition ;
    ex:hasCondition "Clear" .
```

