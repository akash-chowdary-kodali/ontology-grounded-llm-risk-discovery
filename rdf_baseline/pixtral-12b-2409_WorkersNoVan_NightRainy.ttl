    ex:isEngagedIn ex:Roadwork ;
    ex:positionedNear ex:TrafficCone1 ;
    ex:distanceToRoad ex:Close .

ex:Pedestrian2 a ex:Worker ;
    ex:wears ex:HighVisibilityVest ;
    ex:isEngagedIn ex:Roadwork ;
    ex:positionedNear ex:TrafficCone2 ;
    ex:distanceToRoad ex:Close .

ex:TrafficCone1 a ex:Obstacle ;
    ex:color ex:Orange ;
