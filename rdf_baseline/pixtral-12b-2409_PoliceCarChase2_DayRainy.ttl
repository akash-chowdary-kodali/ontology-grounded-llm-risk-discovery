### **3. RDF Triples (Turtle Format)**
```turtle
@prefix : <http://example.org/autonomous-driving#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Scene1 a :AutonomousDrivingScene ;
    :hasWeatherCondition :HeavyRain ;
    :hasRoad :UrbanMultiLaneRoad ;
    :hasObstacle :ReducedVisibilityDueToRain .

:HeavyRain a :WeatherCondition ;
    :reducesVisibility "true"^^xsd:boolean ;
    :affectsRoadSurface "wet"^^xsd:string .

:UrbanMultiLaneRoad a :Road ;
    :hasLane :LaneRight ;
    :hasLane :LaneLeft ;
    :hasInfrastructure :BridgeOverpass .

:LaneRight a :Lane ;
    :containsVehicle :Vehicle_A ;
    :containsVehicle :Vehicle_C ;
    :hasMarking :SolidWhiteLine .

:LaneLeft a :Lane ;
    :containsVehicle :Vehicle_B ;
    :hasMarking :SolidYellowLine .

:Vehicle_A a :Vehicle ;
    :type "SUV"^^xsd:string ;
    :position "right_lane"^^xsd:string ;
    :action :Following ;
    :follows :Vehicle_C .

:Vehicle_B a :Vehicle ;
    :type "Sedan"^^xsd:string ;
    :position "left_lane"^^xsd:string ;
    :action :Approaching ;
    :approaches :Vehicle_C .

:Vehicle_C a :Vehicle ;
    :type "EgoVehicle"^^xsd:string ;
    :position "right_lane"^^xsd:string ;
    :action :Driving .

:BridgeOverpass a :RoadInfrastructure ;
    :location "above_road"^^xsd:string ;
    :material "metal"^^xsd:string ;
    :potentialSensorObstacle "true"^^xsd:boolean .

:ReducedVisibilityDueToRain a :Obstacle ;
    :type "Environmental"^^xsd:string ;
    :severity "High"^^xsd:string .
```

