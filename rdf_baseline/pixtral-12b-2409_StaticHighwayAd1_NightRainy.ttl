    :isOnRoad :RoadSegment1 ;
    :hasHeadlightState :On ;
    :hasSpeedLimitConstraint :SpeedLimit90 .

:RoadSegment1 a :Road ;
    :hasSurfaceCondition :Wet ;
    :hasMarking :DoubleWhiteLine ;
    :hasMarking :DashedLine ;
    :hasTrafficSign :NoParkingSign ;
    :hasTrafficSign :SpeedLimitSign90 .

:TrafficSign1 a :TrafficSign ;
    :hasType :SpeedLimit ;
    :hasValue "90"^^xsd:int ;
    :isLocatedAt :RoadSegment1 .

:TrafficSign2 a :TrafficSign ;
    :hasType :NoParking ;
    :isLocatedAt :RoadSegment1 .

:Streetlight1 a :Streetlight ;
    :isIlluminated :Yes ;
    :illuminates :RoadSegment1 .

:Billboard1 a :Billboard ;
    :occludes :RoadSegment1 .

:Tree1 a :Obstacle ;
    :occludes :RoadSegment1 .
```

