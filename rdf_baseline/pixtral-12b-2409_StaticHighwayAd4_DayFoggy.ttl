    :hasSignal :Red ;
    :isLocatedAt :Intersection .

:NoEntrySign1 a :TrafficSign ;
    :hasSymbol :NoEntry ;
    :isLocatedAt :RightSideOfRoad .

:RoadMarking1 a :RoadMarking ;
    :hasType :LaneDivision ;
    :isObscuredBy :DenseFog .

