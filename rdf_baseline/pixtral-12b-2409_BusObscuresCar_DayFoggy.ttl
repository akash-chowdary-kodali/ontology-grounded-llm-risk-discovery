# Entities
:Vehicle_A a :Vehicle ;
    :hasColor "black" ;
    :hasType "SUV" ;
    :isInLane "right" ;
    :isFollowing :Vehicle_B .

:Vehicle_B a :Vehicle ;
    :hasColor "orange" ;
    :hasType "car" ;
    :isInLane "right" ;
    :isBeingFollowedBy :Vehicle_A .

:Vehicle_C a :Vehicle ;
    :hasColor "gray" ;
    :hasType "car" ;
    :isInLane "left" ;
    :isApproachingFrom "left" .

:Vehicle_D a :Vehicle ;
    :hasType "SUV" ;
    :isEgoVehicle true ;
    :isTrailing :Vehicle_A .

:Fog a :WeatherCondition ;
    :hasVisibilityRange "50-100m" ;
    :isOccluding :Vehicle_C ;
    :isOccluding :Vehicle_B .

:RoadMarkings a :RoadInfrastructure ;
    :hasType "doubleWhiteLines" .

:Streetlights a :RoadInfrastructure ;
    :isNear :RoadMarkings ;
    :isPartiallyObscuredBy :Fog .

# Relationships
:Vehicle_A :hasRelativePositionTo :Vehicle_B "following" .
:Vehicle_D :hasRelativePositionTo :Vehicle_A "trailing" .
:Fog :reducesVisibilityOf :Vehicle_C .
