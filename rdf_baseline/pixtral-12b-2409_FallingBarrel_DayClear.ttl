ex:Scene1 a ex:RoadScene ;
    ex:hasWeatherCondition ex:ClearSky ;
    ex:hasRoad ex:TwoLaneResidentialRoad ;
    ex:hasObstacles ex:RoadCones, ex:LargeRollsOfMaterial, ex:Barrel .

ex:TwoLaneResidentialRoad a ex:Road ;
    ex:hasLane ex:Lane1, ex:Lane2 ;
    ex:hasAdjacentSidewalk ex:LeftSidewalk ;
    ex:hasAdjacentDriveway ex:RightDriveway .

ex:ego_vehicle a ex:Vehicle ;
    ex:hasColor "red" ;
    ex:isApproaching ex:utility_van ;
    ex:hasPerspective ex:FrontView .

ex:utility_van a ex:Vehicle ;
    ex:hasColor "white" ;
    ex:isParkedOn ex:RightDriveway ;
    ex:isBlockedBy ex:LargeRollsOfMaterial ;
    ex:hasWorkers ex:worker_1, ex:worker_2 .

ex:worker_1 a ex:Pedestrian ;
    ex:hasClothing "yellow_shirt" ;
    ex:isNear ex:utility_van ;
    ex:isInteractingWith ex:RoadCones .

ex:worker_2 a ex:Pedestrian ;
    ex:isNear ex:utility_van .

ex:RoadCones a ex:Obstacle ;
    ex:arePlacedBy ex:worker_1 ;
    ex:mark ex:WorkZone .

ex:LargeRollsOfMaterial a ex:Obstacle ;
    ex:areLoadedOn ex:utility_van ;
    ex:areNear ex:RoadCones .

ex:Barrel a ex:Obstacle ;
    ex:isNear ex:utility_van ;
    ex:hasColor "orange" .

ex:LeftSidewalk a ex:Infrastructure ;
    ex:isAdjacentTo ex:residential_houses .

ex:RightDriveway a ex:Infrastructure ;
    ex:isAdjacentTo ex:residential_houses .
```

