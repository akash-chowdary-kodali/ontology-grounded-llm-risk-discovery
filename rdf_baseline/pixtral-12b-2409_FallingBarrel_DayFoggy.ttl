### **Scene Description in RDF Triples (Turtle Format)**

```turtle
@prefix ex: <http://example.org/autonomous-driving#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Scene1 a ex:AutonomousDrivingScene ;
    ex:hasWeatherCondition ex:FoggyConditions ;
    ex:hasRoadMarking ex:DoubleWhiteLine ;
    ex:hasTrafficParticipant ex:Van1, ex:Pedestrian1, ex:Obstacle1, ex:Obstacle2, ex:Obstacle3 .

ex:Van1 a ex:Vehicle ;
    ex:hasColor "gray" ;
    ex:hasPosition "rightLane" ;
    ex:hasActivity ex:LoadingUnloading ;
    ex:hasHazardLights "on" ;
    ex:hasBrakeLights "on" .

ex:Pedestrian1 a ex:Person ;
    ex:hasClothing "yellowShirt" ;
    ex:hasPosition "nearVan" ;
    ex:hasActivity ex:HandlingEquipment ;
    ex:hasTrajectory "movingTowardsVan" .

ex:Obstacle1 a ex:Barrier ;
    ex:hasType "portableBarrier" ;
    ex:hasColor "orange" ;
    ex:hasPosition "rightSideOfVan" .

ex:Obstacle2 a ex:Drum ;
    ex:hasType "hazardousMaterialDrum" ;
    ex:hasColor "black" ;
    ex:hasPosition "nearVan" ;
    ex:hasWarningLabel "flammable" .

ex:Obstacle3 a ex:Drum ;
    ex:hasType "hazardousMaterialDrum" ;
    ex:hasColor "black" ;
    ex:hasPosition "rightSideOfRoad" ;
    ex:hasWarningLabel "corrosive" .

ex:Road a ex:RoadInfrastructure ;
    ex:hasCondition "wet" ;
    ex:hasVisibility "reduced" ;
    ex:hasLaneMarking ex:DoubleWhiteLine .

ex:Relationship1 a ex:SpatialRelationship ;
    ex:subject ex:Pedestrian1 ;
    ex:predicate ex:near ;
    ex:object ex:Van1 .

ex:Relationship2 a ex:SpatialRelationship ;
    ex:subject ex:Van1 ;
    ex:predicate ex:occluding ;
    ex:object ex:Obstacle2 .

ex:Relationship3 a ex:SpatialRelationship ;
    ex:subject ex:Pedestrian1 ;
    ex:predicate ex:interactingWith ;
    ex:object ex:Obstacle1 .
```

