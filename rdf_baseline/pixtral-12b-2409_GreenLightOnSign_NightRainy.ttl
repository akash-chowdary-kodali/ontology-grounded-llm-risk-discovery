```plaintext
Scene Description in RDF Triples (Turtle Format)
```

```turtle
@prefix ex: <http://example.org/autonomous-driving#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Scene1 a ex:NighttimeUrbanScene ;
    ex:hasLightingCondition ex:LowLighting ;
    ex:hasWeatherCondition ex:WetRoad .

ex:Vehicle1 a ex:AutonomousVehicle ;
    ex:isPositionedAt ex:IntersectionApproach ;
    ex:hasHeadlightState ex:On ;
    ex:hasSpeedLimitCompliance ex:Unknown .

ex:TrafficLight1 a ex:TrafficLight ;
    ex:isPositionedAt ex:Intersection ;
    ex:hasSignalState ex:Red .

ex:RoadMarking1 a ex:RoadMarking ;
    ex:isType ex:DoubleWhiteLine ;
    ex:isCondition ex:Wet .

ex:Building1 a ex:Building ;
    ex:isPositionedAt ex:LeftSideOfRoad .

ex:Sign1 a ex:TrafficSign ;
    ex:isPositionedAt ex:RightSideOfRoad ;
    ex:hasType ex:NoEntry .

ex:Vehicle1 ex:isApproaching ex:TrafficLight1 .
ex:Vehicle1 ex:isNear ex:RoadMarking1 .
ex:Vehicle1 ex:isOnRoad ex:WetRoad .
ex:TrafficLight1 ex:isOccludedBy ex:None .
ex:Building1 ex:isAdjacentTo ex:IntersectionApproach .
ex:Sign1 ex:isAdjacentTo ex:RightSideOfRoad .
```

