    ex:isLocatedOn ex:RightSide .

ex:HydroplaningRisk a ex:SafetyRisk ;
    ex:isCausedBy ex:WetRoad ;
    ex:affects ex:EgoVehicle .

ex:SensorOcclusionRisk a ex:SafetyRisk ;
    ex:isCausedBy ex:PuddleReflection ;
    ex:affects ex:DepthPerception .

