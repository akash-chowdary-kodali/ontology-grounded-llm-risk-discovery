### **Scene Description in RDF Triples (Turtle Format)**
```turtle
@prefix ex: <http://example.org/autonomous-driving#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Scene1 a ex:AutonomousDrivingScene ;
    ex:hasWeatherCondition ex:NighttimeLowVisibility ;
    ex:hasTime "Night"^^xsd:string ;
    ex:hasLocation ex:RuralUrbanTransition .

ex:Road1 a ex:Road ;
    ex:hasType "CurvedTwoLane" ;
    ex:hasSurface "Asphalt" ;
    ex:hasLaneMarkings ex:SolidWhite .

ex:Elephant1 a ex:Animal ;
    ex:hasType "Elephant" ;
    ex:hasSize "Large" ;
    ex:hasPosition ex:RightSideOfRoad ;
    ex:hasMovementState "Stationary" ;
    ex:occludes ex:Animal2, ex:Animal3 .

ex:Animal2 a ex:Animal ;
    ex:hasType "Canine" ;
    ex:hasSize "Small" ;
    ex:hasMovementState "Crossing" ;
    ex:hasTrajectory ex:LeftToRight ;
    ex:isNear ex:Road1 .

ex:Animal3 a ex:Animal ;
    ex:hasType "Canine" ;
    ex:hasSize "Small" ;
    ex:hasMovementState "Crossing" ;
    ex:hasTrajectory ex:LeftToRight ;
    ex:isNear ex:Road1 .

ex:EgoVehicle1 a ex:Vehicle ;
    ex:hasType "AutonomousCar" ;
    ex:hasPosition ex:ApproachingIntersection ;
    ex:hasSpeed "Low"^^xsd:float ;
    ex:hasRisk ex:AnimalCrossingRisk .

ex:Building1 a ex:Building ;
    ex:hasType "TwoStory" ;
    ex:isAdjacentTo ex:Road1 .

ex:Streetlight1 a ex:Infrastructure ;
    ex:hasType "Streetlight" ;
    ex:illuminates ex:Road1 ;
    ex:hasVisibilityEffect "Low" .
```

