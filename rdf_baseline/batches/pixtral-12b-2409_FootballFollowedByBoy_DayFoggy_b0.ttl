ex:Scene1 a ex:AutonomousDrivingScene ;
    ex:hasWeatherCondition ex:Fog ;
    ex:hasVisibilityRange "10"^^xsd:integer ;  # Approximate visibility in meters
    ex:hasRoadMarkings ex:LaneLines .

ex:EgoVehicle a ex:Vehicle ;
