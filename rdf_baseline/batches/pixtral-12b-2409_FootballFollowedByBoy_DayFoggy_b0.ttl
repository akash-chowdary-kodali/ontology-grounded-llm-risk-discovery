ex:BlackSUV a ex:Vehicle ;
    ex:hasColor "Black" ;
    ex:isAheadOf ex:EgoVehicle ;
    ex:occludes ex:WhiteCar ;
    ex:occludes ex:Bus .

ex:WhiteCar a ex:Vehicle ;
    ex:hasColor "White" ;
    ex:isOnLeftLane ;
    ex:isPartiallyOccluded .

ex:Bus a ex:Vehicle ;
    ex:isDistant ;
    ex:isPartiallyOccluded .

ex:SoccerBall a ex:Obstacle ;
    ex:isOnRoad ;
    ex:isNear ex:EgoVehicle ;
    ex:mayCauseDistraction .

ex:Fog a ex:WeatherCondition ;
    ex:reducesVisibility ;
    ex:increasesCollisionRisk .
```

