:Vehicle_E a :Car ;
    :hasColor "Unknown" ;
    :isMoving :Approaching ;
    :isInLane :LeftLane ;
    :isFartherAhead true .

:IntersectionTrafficLight a :TrafficLight ;
    :isActive false ;
