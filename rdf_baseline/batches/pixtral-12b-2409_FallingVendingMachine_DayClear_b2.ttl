```turtle
@prefix ex: <http://example.org/autonomous-driving#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Scene1 a ex:DrivingScene ;
    ex:hasWeatherCondition ex:ClearWeather ;
    ex:hasTimeOfDay ex:Daytime .

ex:ClearWeather a ex:WeatherCondition ;
    rdfs:label "Clear weather with no precipitation" .

ex:Daytime a ex:TimeOfDay ;
    rdfs:label "Daytime" .

ex:Road1 a ex:Road ;
    ex:hasLaneMarkings ex:SolidAndDashedLines ;
    ex:hasSurfaceCondition ex:DrySurface ;
    ex:hasObstacle ex:SnowBarrier .

ex:SnowBarrier a ex:Obstacle ;
    ex:hasColor "Red and Orange" ;
    ex:hasMaterial ex:PlasticSpikes ;
    ex:hasLocation ex:RoadShoulder ;
    ex:isPresentIn ex:Road1 .

ex:Building1 a ex:Building ;
    ex:hasLocation ex:LeftSideOfRoad ;
    ex:hasArchitecture ex:ModernMultiStorey .

ex:Building2 a ex:Building ;
    ex:hasLocation ex:RightSideOfRoad ;
    ex:hasArchitecture ex:ModernLowRise .

ex:Vehicle1 a ex:Vehicle ;
    ex:hasType ex:Car ;
    ex:hasColor "Dark" ;
    ex:isMoving ex:Forward ;
    ex:hasPosition ex:MiddleOfRoad ;
    ex:isIn ex:Road1 .

ex:StreetLight1 a ex:StreetLight ;
    ex:hasLocation ex:LeftSideOfRoad ;
    ex:hasStatus ex:On .

ex:StreetLight2 a ex:StreetLight ;
    ex:hasLocation ex:RightSideOfRoad ;
    ex:hasStatus ex:On .

ex:Vehicle1 ex:isApproaching ex:SnowBarrier .
ex:SnowBarrier ex:isOccluding ex:BackgroundBuildings .
ex:Vehicle1 ex:isNear ex:StreetLight2 .
```

