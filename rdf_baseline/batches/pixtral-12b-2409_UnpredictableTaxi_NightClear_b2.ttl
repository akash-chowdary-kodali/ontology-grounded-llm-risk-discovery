```turtle
@prefix ex: <http://example.org/autonomous-driving#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Scene1 a ex:DrivingScene ;
    ex:timeStamp "2023-10-05T23:45:00"^^xsd:dateTime ;
    ex:location "Urban Area" ;
    ex:weatherCondition ex:Night .

ex:egoVehicle a ex:Vehicle ;
    ex:vehicleType "AutonomousCar" ;
    ex:position ex:Lane1 ;
    ex:heading "Forward" ;
    ex:viewPoint ex:FrontCamera .

ex:yellowVehicle a ex:Vehicle ;
    ex:vehicleType "Taxi" ;
    ex:color "Yellow" ;
    ex:position ex:Lane2 ;
    ex:heading "Forward" ;
    ex:distanceFromEgo "Approx. 100 meters" .

ex:redBus a ex:Vehicle ;
    ex:vehicleType "Bus" ;
    ex:color "Red" ;
    ex:position ex:RightSide ;
    ex:heading "Stationary" .

ex:building1 a ex:Building ;
    ex:position ex:LeftSide ;
    ex:height "Multi-Story" .

ex:building2 a ex:Building ;
    ex:position ex:RightSide ;
    ex:height "Multi-Story" .

ex:streetLight1 a ex:StreetLight ;
    ex:position ex:LeftSide ;
    ex:status "On" .

ex:streetLight2 a ex:StreetLight ;
    ex:position ex:RightSide ;
    ex:status "On" .

ex:roadMarking a ex:RoadMarking ;
    ex:type "DoubleYellowLine" ;
    ex:position ex:Lane1 .

ex:roadMarking2 a ex:RoadMarking ;
    ex:type "WhiteLine" ;
    ex:position ex:LaneSeparation .

ex:egoVehicle ex:following ex:yellowVehicle .
ex:yellowVehicle ex:approaching ex:egoVehicle .
ex:redBus ex:stationary ex:RightSide .
ex:building1 ex:occluding ex:streetLight1 .
ex:streetLight1 ex:illuminating ex:roadMarking .
ex:streetLight2 ex:illuminating ex:roadMarking2 .
```

