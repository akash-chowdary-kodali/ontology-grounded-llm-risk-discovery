ex:Scene1 a ex:AutonomousDrivingScene ;
    ex:hasTimeStamp "2023-11-15T23:45:00Z"^^xsd:dateTime ;
    ex:hasWeatherCondition ex:NighttimeLowVisibility .

ex:EgoVehicle a ex:Vehicle ;
    ex:hasColor "white" ;
    ex:hasType "van" ;
    ex:isStationary true ;
    ex:hasPosition [ ex:onRoad true ; ex:near ex:Barrel1 ] .

ex:Pedestrian1 a ex:Person ;
    ex:hasClothing "yellow shirt, jeans" ;
    ex:isStanding true ;
    ex:hasPosition [ ex:near ex:EgoVehicle ; ex:interactingWith ex:RedJack ] .

ex:Barrel1 a ex:Obstacle ;
    ex:hasShape "cylindrical" ;
    ex:hasSize "large" ;
    ex:hasOrientation "tilted" ;
    ex:isBlocking ex:Road ;
    ex:hasPosition [ ex:onRoad true ; ex:near ex:Barrel2 ] .

ex:Barrel2 a ex:Obstacle ;
    ex:hasShape "cylindrical" ;
    ex:hasSize "large" ;
    ex:hasOrientation "upright" ;
    ex:isPartiallyObstructing ex:Road .

ex:RedJack a ex:Object ;
    ex:hasColor "red" ;
    ex:hasPosition [ ex:onGround true ; ex:near ex:Barrel1 ] .

ex:Road a ex:RoadInfrastructure ;
    ex:hasSurface "asphalt" ;
    ex:hasMarkings ex:WhiteDashedLines ;
    ex:isPartiallyObstructedBy ex:Barrel1 .

ex:Risk1 a ex:SafetyRisk ;
    ex:riskType ex:ObstructedRoad ;
    ex:affectedEntity ex:EgoVehicle ;
    ex:severity 0.85 .

ex:Risk2 a ex:SafetyRisk ;
    ex:riskType ex:PedestrianInteraction ;
    ex:affectedEntity ex:Pedestrian1 ;
    ex:severity 0.75 .

ex:Risk3 a ex:SafetyRisk ;
    ex:riskType ex:LowVisibility ;
    ex:affectedEntity ex:EgoVehicle ;
    ex:severity 0.6 .
```

