```plaintext
Scene Description in RDF Triples (Turtle Format)
```

```turtle
@prefix : <http://example.org/autonomous_driving#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Scene1 a :Scene ;
    :hasLightingCondition :LowLighting ;
    :hasWeatherCondition :ClearNight .

:LowLighting a :LightingCondition ;
    :lightIntensity "Low" ;
    :timeOfDay "Night" .

:ClearNight a :WeatherCondition .

:RedCar1 a :Vehicle ;
    :vehicleType "Sedan" ;
    :vehicleColor "Red" ;
    :position :FrontRightLane ;
    :direction :Forward ;
    :speed "Slow" .

:FrontRightLane a :RoadLane ;
    :lanePosition "Right" ;
    :laneType "Driving" .

:RoadObstacle1 a :RoadObstacle ;
    :type "SpeedBump" ;
    :location :FrontRightLane ;
    :height "Low" .

:Building1 a :Infrastructure ;
    :type "Warehouse" ;
    :position :RightSide .

:StreetLight1 a :Infrastructure ;
    :type "StreetLight" ;
    :position :LeftSide ;
    :lightStatus "On" .

:RedCar1 :hasObstacle :RoadObstacle1 .
:RedCar1 :isNear :Building1 .
:RedCar1 :isUnder :StreetLight1 .
```

