@prefix ex: <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

ex:Scene1 rdf:type ex:TrafficScene ;
    ex:hasEntity ex:YellowTaxi, ex:RedCar, ex:Road, ex:StreetLights, ex:Buildings ;
    ex:hasWeather ex:NightTime ;

ex:YellowTaxi rdf:type ex:Vehicle ;
    ex:hasColor "Yellow" ;
    ex:drivingDirection "Forward" ;
    ex:interactsWith ex:RedCar .

ex:RedCar rdf:type ex:Vehicle ;
    ex:hasColor "Red" ;
    ex:drivingDirection "Following" ;
    ex:interactsWith ex:YellowTaxi .

ex:Road rdf:type ex:Infrastructure ;
    ex:hasCondition "Dry" .

ex:StreetLights rdf:type ex:Infrastructure ;
    ex:areOn "Yes" .

ex:Buildings rdf:type ex:Infrastructure ;
    ex:location "Adjacent to Road" .
```

