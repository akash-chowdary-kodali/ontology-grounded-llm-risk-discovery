### Scene Description in RDF Triples (Turtle Format)

```turtle
@prefix ex: <http://example.org/autonomous-driving#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Scene1 a ex:DrivingScene ;
    ex:hasWeatherCondition ex:WetRoadCondition ;
    ex:hasLightCondition ex:LowLightCondition .

ex:Vehicle1 a ex:Vehicle ;
    ex:hasColor "red" ;
    ex:hasPosition ex:Position1 ;
    ex:isDrivingOn ex:Lane1 ;
    ex:hasSpeed "low" ;
    ex:hasType ex:AutonomousVehicle .

ex:Vehicle2 a ex:Vehicle ;
    ex:hasColor "green" ;
    ex:hasPosition ex:Position2 ;
    ex:isDrivingOn ex:Lane2 ;
    ex:hasSpeed "low" ;
    ex:hasDirection ex:OppositeDirection .

ex:Vehicle3 a ex:Vehicle ;
    ex:hasColor "white" ;
    ex:hasPosition ex:Position3 ;
    ex:isParked ex:ParkingSpace1 .

ex:Road a ex:RoadInfrastructure ;
    ex:hasLane ex:Lane1 ;
    ex:hasLane ex:Lane2 ;
    ex:hasSurfaceCondition ex:WetSurface ;
    ex:hasObstacle ex:Puddle1 .

ex:Puddle1 a ex:Obstacle ;
    ex:hasLocation ex:Position4 ;
    ex:hasSize "large" ;
    ex:hasType ex:WaterPuddle .

ex:Building1 a ex:Building ;
    ex:hasLocation ex:LeftSideOfRoad ;
    ex:hasLighting ex:StreetLighting .

ex:StreetLight1 a ex:LightSource ;
    ex:isOn "true" ;
    ex:illuminates ex:Road .

ex:Position1 a ex:Position ;
    ex:hasCoordinates "0, 0"^^xsd:string ;
    ex:isOn ex:Lane1 .

ex:Position2 a ex:Position ;
    ex:hasCoordinates "100, 50"^^xsd:string ;
    ex:isOn ex:Lane2 .

ex:Position3 a ex:Position ;
    ex:hasCoordinates "150, 70"^^xsd:string ;
    ex:isIn ex:ParkingSpace1 .

ex:Position4 a ex:Position ;
    ex:hasCoordinates "50, 0"^^xsd:string .

ex:Lane1 a ex:Lane ;
    ex:hasMarking ex:YellowLine ;
    ex:hasDirection ex:ForwardDirection .

ex:Lane2 a ex:Lane ;
    ex:hasMarking ex:WhiteLine ;
    ex:hasDirection ex:OppositeDirection .
```

