### **Scene Description in RDF Triples (Turtle Format)**
```turtle
@prefix ex: <http://example.org/autonomous-driving#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Scene1 a ex:UndergroundTunnelScene ;
    ex:hasLightingCondition ex:LowArtificialLighting ;
    ex:hasWeatherCondition ex:Clear ;
    ex:hasRoadSurface ex:AsphaltWithLaneMarkings .

ex:EgoVehicle a ex:AutonomousVehicle ;
    ex:isLocatedIn ex:Scene1 ;
    ex:hasPosition ex:FrontOfTunnel ;
    ex:hasMotionDirection ex:Forward .

ex:DistantVehicle a ex:Vehicle ;
    ex:isLocatedIn ex:Scene1 ;
    ex:isPositioned ex:AheadOfEgoVehicle ;
    ex:hasDistanceFromEgo ex:Approx100Meters ;
    ex:hasMotionDirection ex:Forward .

ex:ParkedVehicles a ex:VehicleGroup ;
    ex:isLocatedIn ex:Scene1 ;
    ex:isPositioned ex:RightSideOfTunnel ;
    ex:hasMotionState ex:Stationary .

ex:TunnelWalls a ex:RoadInfrastructure ;
    ex:isPartOf ex:Scene1 ;
    ex:hasMaterial ex:Concrete ;
    ex:hasOcclusionEffect ex:LimitedVisibility .

ex:OverheadLighting a ex:LightingSystem ;
    ex:isPartOf ex:Scene1 ;
    ex:hasIntensity ex:Variable ;
    ex:hasIlluminationEffect ex:ReducedDistanceVisibility .
```

