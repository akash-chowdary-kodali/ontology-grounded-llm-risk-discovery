    ex:hasPosition "left" .

ex:Building2 a ex:Building ;
    ex:hasPosition "right" .

# Relationships
ex:Vehicle1 ex:isNear ex:Pedestrian1 .
ex:Vehicle1 ex:isFollowing ex:Vehicle2 .
ex:Pedestrian1 ex:isCrossing ex:Road .
ex:Dog1 ex:isNear ex:Vehicle2 .
ex:TrafficLight1 ex:isOccludedBy ex:HeavyFog .
ex:TrafficLight2 ex:isOccludedBy ex:HeavyFog .
