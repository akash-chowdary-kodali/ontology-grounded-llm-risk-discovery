```plaintext
Scene Description in RDF Triples (Turtle Format)
```

```turtle
@prefix ex: <http://example.org/autonomousDriving#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Scene1 a ex:DrivingScene ;
    ex:hasLightingCondition ex:LowLighting ;
    ex:hasWeatherCondition ex:Foggy .

ex:Vehicle1 a ex:AutonomousVehicle ;
    ex:isPositionedAt ex:IntersectionLane ;
    ex:hasSpeed 0 ;
    ex:hasObstacleInFront ex:LargeObstacle .

ex:LargeObstacle a ex:Obstacle ;
    ex:isType ex:Debris ;
    ex:isPositionedAt ex:RoadCenter ;
    ex:isDistanceFromVehicle ex:ShortDistance ;
    ex:isSize ex:Large .

ex:TrafficLight1 a ex:TrafficLight ;
    ex:isPositionedAt ex:Intersection ;
    ex:hasSignal ex:Red .

ex:Vehicle2 a ex:Vehicle ;
    ex:isPositionedAt ex:OppositeLane ;
    ex:isFollowing ex:TrafficRules .

ex:StreetLight1 a ex:StreetLight ;
    ex:isPositionedAt ex:Intersection ;
    ex:isIlluminatingArea ex:IntersectionArea .

ex:RoadMarking1 a ex:RoadMarking ;
    ex:isType ex:Crosswalk ;
    ex:isPositionedAt ex:Intersection .

ex:Fog a ex:WeatherCondition ;
    ex:reducesVisibility ex:HighReduction .
```

