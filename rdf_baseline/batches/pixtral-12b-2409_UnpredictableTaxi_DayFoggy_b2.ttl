### Scene Description in RDF Triples (Turtle Format)

```turtle
@prefix : <http://example.org/autonomous-driving#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Scene1 a :DrivingScene ;
    :hasWeatherCondition :FoggyCondition ;
    :hasVisibilityDistance "low" ;
    :timestamp "2023-10-05T14:30:00Z"^^xsd:dateTime .

:FoggyCondition a :WeatherCondition ;
    :visibilityRangeMeters 20 ;
    :obscuresObjects true .

:Vehicle1 a :AutonomousVehicle ;
    :positionOnRoad :Lane2 ;
    :direction :Forward ;
    :speed "20"^^xsd:kmPerHour ;
    :hasSensorData :Active .

:Vehicle2 a :TaxiVehicle ;
    :positionOnRoad :Lane2 ;
    :direction :Forward ;
    :distanceFrom :Vehicle1 30 ;
    :speed "15"^^xsd:kmPerHour .

:RoadInfrastructure1 a :Road ;
    :hasLane :Lane1, :Lane2 ;
    :hasTrafficLight :TrafficLight1, :TrafficLight2 ;
    :hasSidewalk :Sidewalk1, :Sidewalk2 ;
    :hasObstacle :None .

:TrafficLight1 a :TrafficLight ;
    :position :Intersection1 ;
    :status :Green .

:Intersection1 a :Intersection ;
    :hasTrafficLight :TrafficLight1, :TrafficLight2 ;
    :hasCrosswalk :Crosswalk1 .

:Crosswalk1 a :Crosswalk ;
    :position :Intersection1 ;
    :hasPedestrian :None .

:Lane1 a :Lane ;
    :laneNumber 1 ;
    :direction :Forward .

:Lane2 a :Lane ;
    :laneNumber 2 ;
    :direction :Forward .

:Building1 a :Building ;
    :position :RightSideOfRoad ;
    :obstructsView true .
```

