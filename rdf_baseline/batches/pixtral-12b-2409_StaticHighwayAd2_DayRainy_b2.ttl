```plaintext
Scene Description in RDF Triples (Turtle Format)
```

```turtle
@prefix ex: <http://example.org/ns#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Scene1 a ex:DrivingScene ;
    ex:hasWeatherCondition ex:HeavyFog ;
    ex:hasRoadInfrastructure ex:RoadInfrastructure1 .

ex:RoadInfrastructure1 a ex:RoadInfrastructure ;
    ex:hasRoadMarking ex:DoubleWhiteLine ;
    ex:hasRoadSurfaceCondition ex:Wet ;
    ex:hasTrafficSign ex:TrafficSign1 ;
    ex:hasLampPost ex:LampPost1 .

ex:TrafficSign1 a ex:TrafficSign ;
    ex:hasType "Speed Limit" ;
    ex:hasVisibility "Low" .

ex:LampPost1 a ex:LampPost ;
    ex:hasVisibility "Low" .

ex:HeavyFog a ex:WeatherCondition ;
    ex:hasVisibilityRange "Low" ;
    ex:hasPrecipitation "None" .

ex:Vehicle1 a ex:Vehicle ;
    ex:hasPosition "OnRoad" ;
    ex:hasVisibilityCondition "Reduced" ;
    ex:hasFrontView "Obscured" .

ex:Scene1 ex:containsEntity ex:Vehicle1 .
ex:Vehicle1 ex:isInCondition ex:HeavyFog .
ex:Vehicle1 ex:isOnSurface ex:Wet .
```

