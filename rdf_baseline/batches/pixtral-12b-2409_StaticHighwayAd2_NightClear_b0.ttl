:Risk1 a :SafetyRisk ;
    :riskType :LowVisibilityRisk ;
    :description "Nighttime driving with low visibility increases reaction time and detection difficulty for pedestrians/vehicles." ;
    :severity 0.6 .

:Risk2 a :SafetyRisk ;
    :riskType :EmptyRoadMisjudgment ;
    :description "Empty road may lead to overconfidence in speed or lack of attention to traffic signs." ;
    :severity 0.4 .

:Risk3 a :SafetyRisk ;
    :riskType :TrafficSignOcclusion ;
    :description "Billboards and streetlights may partially occlude traffic signs, reducing their visibility." ;
    :severity 0.5 .
