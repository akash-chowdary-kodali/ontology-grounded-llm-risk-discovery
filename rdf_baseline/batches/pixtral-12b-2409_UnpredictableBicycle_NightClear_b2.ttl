```plaintext
Scene Description in RDF Triples (Turtle Format)
```

```turtle
@prefix ex: <http://example.org/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Scene1 a ex:DrivingScene ;
    ex:timeStamp "2023-10-05T23:45:00"^^xsd:dateTime ;
    ex:location "Urban Area" ;
    ex:weatherCondition ex:Night .

ex:Vehicle1 a ex:AutonomousVehicle ;
    ex:position "OnRoad" ;
    ex:hasCamera ex:FrontCamera ;
    ex:hasObstacleInView ex:Obstacle1 .

ex:Obstacle1 a ex:UnknownObject ;
    ex:location "OnRoad" ;
    ex:distanceFromVehicle "Close" ;
    ex:occludedBy ex:Person1 ;
    ex:position "CenterOfRoad" .

ex:Person1 a ex:Pedestrian ;
    ex:action "Crossing" ;
    ex:location "NearVehicle" ;
    ex:carrying ex:Object2 .

ex:Object2 a ex:Object ;
    ex:type "Unknown" ;
    ex:size "Large" .

ex:RoadInfrastructure1 a ex:Road ;
    ex:type "UrbanStreet" ;
    ex:hasLaneMarkings ex:YellowLines ;
    ex:hasBuildings ex:Building1 .

ex:Building1 a ex:Building ;
    ex:location "LeftSideOfRoad" .

ex:LightingCondition a ex:Lighting ;
    ex:type "LowLight" ;
    ex:source "StreetLights" .
```

