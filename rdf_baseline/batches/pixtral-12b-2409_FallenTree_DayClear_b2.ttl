### Scene Description in RDF Triples (Turtle Format)

```turtle
@prefix : <http://example.org/autonomous-driving#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Scene1 a :Scene ;
    :hasWeatherCondition :ClearWeather ;
    :hasRoadInfrastructure :UrbanRoadInfrastructure .

:UrbanRoadInfrastructure a :RoadInfrastructure ;
    :hasLaneMarkings :DoubleYellowLines ;
    :hasTrafficSigns :MultipleSigns ;
    :hasTrafficLight :Present ;
    :hasObstacles :None .

:ClearWeather a :WeatherCondition ;
    :hasVisibility :High ;
    :hasLightingCondition :Daylight .

:Vehicle1 a :Vehicle ;
    :hasColor "Yellow" ;
    :hasType :Taxi ;
    :hasPosition :RightLane ;
    :hasDirection :Forward ;
    :hasSpeed :Moderate .

:Vehicle2 a :Vehicle ;
    :hasColor "Gray" ;
    :hasType :Sedan ;
    :hasPosition :OppositeLane ;
    :hasDirection :Forward ;
    :hasSpeed :Slow .

:Tree1 a :Obstacle ;
    :hasType :Vegetation ;
    :hasPosition :LeftSide ;
    :hasEffect :Occlusion .

:Building1 a :Infrastructure ;
    :hasType :HighRise ;
    :hasPosition :Background .

:Scene1 :hasEntity :Vehicle1 .
:Scene1 :hasEntity :Vehicle2 .
:Scene1 :hasEntity :Tree1 .
:Scene1 :hasEntity :Building1 .

:Vehicle1 :isFollowing :Vehicle2 .
:Vehicle2 :isApproaching :Vehicle1 .
:Tree1 :isOccluding :Vehicle2 .
```

