    ex:condition "Wet/Rainy" ;
    ex:visibility "Low" .

ex:BusStop a ex:Infrastructure ;
    ex:near ex:BrickWall .

ex:BrickWall a ex:Infrastructure ;
    ex:adjacentTo ex:Road .
