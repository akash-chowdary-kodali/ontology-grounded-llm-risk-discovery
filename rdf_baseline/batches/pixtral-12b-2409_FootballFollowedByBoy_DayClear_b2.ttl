ex:Scene1 a ex:DrivingScene ;
    ex:hasWeatherCondition ex:ClearWeather ;
    ex:hasTimeOfDay ex:Daytime .

ex:Vehicle1 a ex:AutonomousVehicle ;
    ex:hasPosition "Front-Center" ;
    ex:hasSpeed "0 km/h"^^xsd:float ;
    ex:hasFieldOfView ex:ForwardView .

ex:Vehicle2 a ex:EmergencyVehicle ;
    ex:hasPosition "Approaching from Left" ;
    ex:hasSpeed "30 km/h"^^xsd:float ;
    ex:hasColor "Red" .

ex:Pedestrian1 a ex:Pedestrian ;
    ex:hasPosition "Crossing from Right" ;
    ex:hasActivity ex:Running ;
    ex:hasDirection ex:TowardsForeground .

ex:SoccerBall1 a ex:Object ;
    ex:hasPosition "LeftSide" ;
    ex:hasType ex:SportBall .

ex:Road a ex:RoadInfrastructure ;
    ex:hasType ex:ResidentialStreet ;
    ex:hasCondition ex:Dry .

ex:House1 a ex:Building ;
    ex:hasPosition "LeftSide" .

ex:Tree1 a ex:Obstacle ;
    ex:hasPosition "Background" ;
    ex:hasType ex:Vegetation .

ex:Vehicle1 ex:isNear ex:Pedestrian1 .
ex:Vehicle1 ex:hasObstacle ex:SoccerBall1 .
ex:Vehicle2 ex:isApproaching ex:Vehicle1 .
ex:Pedestrian1 ex:isCrossing ex:Road .
ex:Tree1 ex:isOccluding ex:Building .
