    ex:hasWeatherCondition ex:ClearWeather ;
    ex:hasTimeStamp "2023-10-01T12:00:00Z"^^xsd:dateTime .

ex:Pedestrian1 a ex:Pedestrian ;
    ex:hasLocation ex:RoadCenter ;
    ex:isMoving ex:TowardAVPath ;
    ex:hasTrajectory ex:CrossingRoad ;
    ex:hasSpeed "1.2 m/s"^^xsd:float .

ex:TrafficCone1 a ex:TrafficCone ;
    ex:hasLocation ex:LeftLane ;
    ex:isNear ex:Obstacle1 ;
    ex:hasColor "orange" .

ex:TrafficCone2 a ex:TrafficCone ;
    ex:hasLocation ex:LeftLane ;
    ex:isNear ex:Obstacle1 .

ex:Obstacle1 a ex:Obstacle ;
    ex:hasType "Barrel" ;
    ex:hasLocation ex:LeftLane ;
    ex:isPartiallyOccludedBy ex:TrafficCone1, ex:TrafficCone2 .

ex:Road a ex:Road ;
    ex:hasLaneMarkings ex:SolidWhiteLines ;
    ex:hasAdjacentSidewalk ex:RightSidewalk ;
    ex:hasTrafficSigns ex:UnclearSigns .

ex:AV1 a ex:AutonomousVehicle ;
    ex:hasViewpoint ex:FrontCamera ;
    ex:isApproaching ex:Pedestrian1 ;
    ex:isNear ex:Obstacle1 .
```

