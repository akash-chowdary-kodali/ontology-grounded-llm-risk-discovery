### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix ex: <http://example.org/> .

ex:Scene1 a ex:Scene ;
    ex:hasVehicle ex:Vehicle1, ex:Vehicle2 ;
    ex:hasWeatherCondition ex:Rainy ;
    ex:hasRoadInfrastructure ex:Overpass, ex:StreetLights ;
    ex:hasObstacles ex:WaterPuddles ;
    ex:hasBuilding ex:Building1, ex:Building2, ex:Building3 .

ex:Vehicle1 a ex:Vehicle ;
    ex:hasType "Car" ;
    ex:hasDirection "Facing Forward" ;
    ex:isNear ex:Vehicle2 .

ex:Vehicle2 a ex:Vehicle ;
    ex:hasType "Car" ;
    ex:hasDirection "Facing Forward" ;
    ex:isApproaching ex:Vehicle1 .

ex:Overpass a ex:Infrastructure ;
    ex:hasStatus "Rusty" .

ex:StreetLights a ex:Infrastructure ;
    ex:hasStatus "On" .

ex:WaterPuddles a ex:Obstacle ;
    ex:hasLocation "On Road" .

ex:Building1 a ex:Building ;
    ex:hasColor "Gray" .

ex:Building2 a ex:Building ;
    ex:hasColor "Red" .

ex:Building3 a ex:Building ;
    ex:hasColor "White" .

ex:Rainy a ex:WeatherCondition ;
    ex:hasVisibility "Low" .
```

