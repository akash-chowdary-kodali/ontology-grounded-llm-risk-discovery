### **Scene Description in RDF Triples (Turtle Format)**
```turtle
@prefix ex: <http://example.org/autonomous-driving#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Scene1 a ex:AutonomousDrivingScene ;
    ex:hasWeatherCondition ex:Nighttime ;
    ex:hasWeatherCondition ex:RecentRain .

ex:EgoVehicle a ex:Vehicle ;
    ex:hasColor "black" ;
    ex:isDrivingDirection ex:Forward ;
    ex:isPositionedOn ex:RoadSurface ;
    ex:hasSpeed ex:ModerateSpeed .

ex:OpposingVehicle a ex:Vehicle ;
    ex:hasColor "black" ;
    ex:isDrivingDirection ex:OppositeDirection ;
    ex:isApproaching ex:EgoVehicle ;
    ex:isPositionedOn ex:RoadSurface .

ex:RoadSurface a ex:Road ;
    ex:hasCondition ex:Wet ;
    ex:hasObstacle ex:Puddle ;
    ex:hasMarking ex:DoubleWhiteLine .

ex:Puddle a ex:Obstacle ;
    ex:causes ex:Glare ;
    ex:reduces ex:Traction .

ex:Streetlight a ex:Infrastructure ;
    ex:provides ex:LimitedIllumination .

ex:Building a ex:Infrastructure ;
    ex:creates ex:Shadow ;
    ex:occludes ex:Visibility .

ex:OverheadStructure a ex:Infrastructure ;
    ex:occludes ex:Visibility .

ex:Nighttime a ex:WeatherCondition ;
    ex:reduces ex:AmbientLight .

ex:RecentRain a ex:WeatherCondition ;
    ex:causes ex:WetRoad .
```

