```plaintext
Scene Description in RDF Triples (Turtle Format)
```

```turtle
@prefix ex: <http://example.org/autonomousDriving#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Scene1 a ex:UndergroundParkingScene ;
    ex:hasLightingCondition ex:LowLighting ;
    ex:hasWeatherCondition ex:Clear ;
    ex:hasRoadSurfaceCondition ex:Dry .

ex:Vehicle1 a ex:AutonomousVehicle ;
    ex:hasPosition "ApproachingCurve" ;
    ex:hasSpeed "Low"^^xsd:string ;
    ex:hasHeadlightsState ex:On .

ex:Vehicle2 a ex:ParkingVehicle ;
    ex:hasPosition "StationaryOnRight" ;
    ex:hasDistanceFromVehicle1 "15meters"^^xsd:string .

ex:ParkingStructure1 a ex:ParkingStructure ;
    ex:hasCurve ex:SharpCurve ;
    ex:hasWallOnRight ex:BrickWall .

ex:Vehicle1 ex:isApproaching ex:Vehicle2 .
ex:Vehicle1 ex:isNear ex:BrickWall .
ex:Vehicle2 ex:isOccluding ex:PartOfCurve .
ex:Vehicle1 ex:hasFieldOfViewRestriction ex:LowLighting .
```

