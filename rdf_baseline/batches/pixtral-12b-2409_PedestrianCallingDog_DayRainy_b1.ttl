ex:TrafficLight1 a ex:TrafficLight ;
    ex:isVisible "False" ;
    ex:isOccludedBy ex:HeavyFog .

ex:Risk1 a ex:SafetyRisk ;
    ex:riskType ex:AnimalCrossing ;
    ex:affectedEntity ex:RedCar ;
    ex:severity 0.95 .

ex:Risk2 a ex:SafetyRisk ;
    ex:riskType ex:ReducedVisibility ;
    ex:affectedEntity ex:AllVehicles ;
