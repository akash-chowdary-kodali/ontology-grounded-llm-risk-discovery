```plaintext
Scene Description in RDF Triples (Turtle Format)
```

```turtle
@prefix ex: <http://example.org/autonomousDriving#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

ex:Scene1 a ex:UndergroundParkingScene ;
    ex:hasLightingCondition ex:LowLighting ;
    ex:hasWeatherCondition ex:Clear ;
    ex:hasRoadSurfaceCondition ex:Dry .

ex:Vehicle1 a ex:AutonomousVehicle ;
    ex:isLocatedAt ex:ParkingLane ;
    ex:isMoving ex:False ;
    ex:hasPosition ex:MiddleDistance .

ex:Vehicle2 a ex:StationaryVehicle ;
    ex:isLocatedAt ex:ParkingSpot ;
    ex:isMoving ex:False ;
    ex:hasPosition ex:FarDistance .

ex:ParkingLane1 a ex:ParkingLane ;
    ex:hasCurve ex:SharpCurve ;
    ex:hasSurfaceMarking ex:ParkingMarkings .

ex:Wall1 a ex:ParkingStructureWall ;
    ex:isLocatedAt ex:RightSideOfLane ;
    ex:hasMaterial ex:Concrete .

ex:Lighting1 a ex:ArtificialLighting ;
    ex:isLocatedAt ex:Ceiling ;
    ex:hasIntensity ex:Low .

ex:Vehicle1 ex:isApproaching ex:Vehicle2 .
ex:Vehicle1 ex:isNear ex:Wall1 .
ex:Vehicle1 ex:isIn ex:ParkingLane1 .
ex:ParkingLane1 ex:hasObstacleRisk ex:SharpCurve .
```

