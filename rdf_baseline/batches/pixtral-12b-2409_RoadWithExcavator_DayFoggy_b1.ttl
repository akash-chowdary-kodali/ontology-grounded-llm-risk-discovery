    :hasType "Excavator" ;
    :hasPosition "RightLane" ;
    :hasEquipment :ExcavatorBucket ;
    :isPartiallyOnRoad true .

:ExcavatorBucket a :Obstacle ;
    :isAttachedTo :ConstructionVehicle ;
    :isExtendingIntoRoad true ;
    :hasRisk :DynamicObstacleRisk .

