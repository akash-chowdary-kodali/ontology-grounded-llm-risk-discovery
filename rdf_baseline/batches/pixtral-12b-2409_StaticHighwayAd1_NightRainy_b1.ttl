    :hasType :NoParking ;
    :isLocatedAt :RoadSegment1 .

:Streetlight1 a :Streetlight ;
    :isIlluminated :Yes ;
    :illuminates :RoadSegment1 .

:Billboard1 a :Billboard ;
    :occludes :RoadSegment1 .

