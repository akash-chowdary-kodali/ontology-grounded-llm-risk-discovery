```turtle
@prefix ex: <http://example.org/autonomous-driving#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

ex:Scene1 a ex:NighttimeRoadScene ;
    ex:hasRoad ex:TwoLaneRoad ;
    ex:hasSpeedLimit ex:SpeedLimit90kmh ;
    ex:hasTrafficSign ex:NoEntrySign ;
    ex:hasTrafficSign ex:NoStoppingSign ;
    ex:hasAdvertisementSign ex:RestaurantAd ;
    ex:hasLighting ex:Streetlight ;
    ex:hasRoadMarking ex:DoubleWhiteLine ;
    ex:hasBoundary ex:BrickWall ;
    ex:hasBoundary ex:Tree ;
    ex:hasWeatherCondition ex:Nighttime ;
    ex:hasVisibility ex:LowVisibility .

ex:TwoLaneRoad a ex:Road ;
    ex:hasLane ex:Lane1 ;
    ex:hasLane ex:Lane2 ;
    ex:hasMarking ex:DoubleWhiteLine .

ex:SpeedLimit90kmh a ex:SpeedLimitSign ;
    ex:hasValue "90"^^xsd:integer ;
    ex:hasUnit "km/h" .

ex:RestaurantAd a ex:AdvertisementSign ;
    ex:hasText "ARE YOU HUNGRY? FOR DINNER" ;
    ex:hasLocation ex:AboveRoad .

ex:Streetlight a ex:Lighting ;
    ex:hasState ex:On ;
    ex:hasIlluminationLevel ex:Low .

ex:DoubleWhiteLine a ex:RoadMarking ;
    ex:indicates ex:NoOvertaking .

ex:Nighttime a ex:WeatherCondition ;
    ex:hasTime ex:Night ;
    ex:hasVisibility ex:Low .
```

