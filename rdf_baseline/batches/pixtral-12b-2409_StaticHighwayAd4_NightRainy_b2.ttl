```plaintext
Scene Description in RDF Triples (Turtle Format)
```

```turtle
@prefix ex: <http://example.org/autonomous-driving#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Scene1 a ex:DrivingScene ;
    ex:hasLightingCondition ex:LowLighting ;
    ex:hasWeatherCondition ex:WetRoad .

ex:Road a ex:RoadInfrastructure ;
    ex:hasLaneMarkings ex:DoubleSolidWhite ;
    ex:hasSurfaceCondition ex:Wet .

ex:Vehicle1 a ex:Vehicle ;
    ex:hasPosition ex:OnRoad ;
    ex:hasOrientation ex:Forward ;
    ex:hasSpeed ex:LowSpeed ;
    ex:hasHeadlightState ex:On .

ex:Building1 a ex:Building ;
    ex:isLocated ex:RightSideOfRoad .

ex:StreetLight1 a ex:StreetLight ;
    ex:isLocated ex:LeftSideOfRoad ;
    ex:hasState ex:On .

ex:Vehicle1 ex:isApproaching ex:Building1 .
ex:Vehicle1 ex:isNear ex:StreetLight1 .
ex:Road ex:isOccludedBy ex:Building1 .
ex:Road ex:hasSurfaceReflection ex:WetSurface .
```

