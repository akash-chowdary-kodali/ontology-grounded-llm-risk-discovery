ex:Traffic_Light_2 a ex:TrafficLight ;
    ex:color "Red" ;
    ex:controls ex:Right_Lane .

ex:Traffic_Light_3 a ex:TrafficLight ;
    ex:color "Green" ;
    ex:controls ex:Perpendicular_Lane .

