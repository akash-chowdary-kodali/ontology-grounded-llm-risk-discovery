    ex:hasColor "Green (left turn)" ;
    ex:hasLocation "Left side of intersection" .

ex:road a ex:Road ;
    ex:hasLaneMarkings "Double white lines" ;
    ex:hasTrafficSigns ex:noRightTurnSign ;
    ex:hasTrafficSigns ex:noUturnSign .

