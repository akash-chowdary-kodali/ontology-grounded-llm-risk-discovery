```plaintext
Scene Description in RDF Triples (Turtle Format)
```

```turtle
@prefix ex: <http://example.org/autonomousDriving#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Scene1 a ex:DrivingScene ;
    ex:timeStamp "2023-10-05T23:45:00"^^xsd:dateTime ;
    ex:location "Urban Road" ;
    ex:weatherCondition ex:Night .

ex:Road ex:partOf ex:Scene1 ;
    ex:hasLaneMarkings ex:DoubleSolidWhite ;
    ex:hasCurve ex:GentleCurve ;
    ex:hasSpeedLimit "60"^^xsd:integer ;
    ex:hasLighting ex:StreetLights .

ex:Vehicle1 a ex:AutonomousVehicle ;
    ex:positionedOn ex:Road ;
    ex:direction ex:Forward ;
    ex:hasHeadlights ex:On .

ex:Billboard1 a ex:RoadSign ;
    ex:positionedOn ex:Road ;
    ex:location ex:RightSide ;
    ex:content "Advertisement" .

ex:Pedestrian1 a ex:Pedestrian ;
    ex:positionedOn ex:Sidewalk ;
    ex:location ex:FarRight ;
    ex:distanceFromVehicle ex:Far .

ex:StreetLight1 a ex:StreetLight ;
    ex:positionedOn ex:Road ;
    ex:status ex:On ;
    ex:illuminationLevel ex:Low .

ex:Obstacle1 a ex:PotentialObstacle ;
    ex:positionedOn ex:Road ;
    ex:type ex:UnknownObject ;
    ex:distanceFromVehicle ex:Far .

ex:Vehicle1 ex:approaching ex:Billboard1 .
ex:Vehicle1 ex:near ex:StreetLight1 .
ex:Vehicle1 ex:notNear ex:Pedestrian1 .
ex:Obstacle1 ex:occludedBy ex:Billboard1 .
ex:Pedestrian1 ex:crossingPotential ex:Road .
```

