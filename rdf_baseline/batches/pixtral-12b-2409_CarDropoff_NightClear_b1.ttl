### **Scene Description in RDF Triples (Turtle Format)**
```turtle
@prefix ex: <http://example.org/autonomous-driving#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Entities
ex:Scene1 a ex:NighttimeUrbanScene ;
    ex:hasWeatherCondition ex:Nighttime ;
    ex:hasWeatherCondition ex:DryRoad .

ex:EgoVehicle a ex:Vehicle ;
    ex:hasColor "black" ;
    ex:hasPosition "center" ;
    ex:hasSpeed "moderate" .

ex:Ambulance a ex:EmergencyVehicle ;
    ex:hasColor "white/red" ;
    ex:hasPosition "left" ;
    ex:hasSpeed "fast" ;
    ex:hasPriority true .

ex:OccludedVehicle a ex:Vehicle ;
    ex:hasPosition "right" ;
    ex:hasSpeed "moderate" ;
    ex:isOccluded true .

ex:Streetlight1 a ex:Streetlight ;
    ex:isIlluminated true ;
    ex:hasIntensity "medium" .

ex:Sidewalk1 a ex:RoadInfrastructure ;
    ex:hasCrossing true .

# Relationships
ex:EgoVehicle ex:isFollowing ex:Ambulance .
ex:EgoVehicle ex:isNear ex:OccludedVehicle .
ex:Ambulance ex:hasPriorityOver ex:EgoVehicle .
ex:Streetlight1 ex:illuminates ex:Scene1 .
ex:Scene1 ex:hasLowVisibility true .

# Potential Risks
ex:Risk1 a ex:BlindSpotRisk ;
    ex:affects ex:OccludedVehicle ;
    ex:severity 0.85 .

ex:Risk2 a ex:EmergencyVehicleInteractionRisk ;
    ex:affects ex:Ambulance ;
    ex:severity 0.75 .

ex:Risk3 a ex:PedestrianUndetectionRisk ;
    ex:affects ex:Scene1 ;
    ex:severity 0.9 .
```

