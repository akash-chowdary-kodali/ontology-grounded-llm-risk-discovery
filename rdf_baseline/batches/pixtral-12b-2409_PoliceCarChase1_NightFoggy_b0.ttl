### **Scene Description in RDF Triples (Turtle Format)**
```turtle
@prefix ex: <http://example.org/autonomous-driving#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Scene1 a ex:AutonomousDrivingScene ;
    ex:hasEntity ex:EgoVehicle, ex:DistantVehicle, ex:Tunnel, ex:Lighting, ex:RoadSurface .

ex:EgoVehicle a ex:Vehicle ;
    ex:isLocatedIn ex:Tunnel ;
    ex:hasHeadlightsActive true ;
    ex:hasSpeed ex:LowSpeed .

ex:DistantVehicle a ex:Vehicle ;
    ex:isLocatedIn ex:Tunnel ;
    ex:isAheadOf ex:EgoVehicle ;
    ex:hasVisibility ex:Low .

ex:Tunnel a ex:RoadInfrastructure ;
    ex:hasWalls ex:BrickWalls ;
    ex:hasLighting ex:OverheadLighting ;
    ex:hasCurvature ex:SlightCurve .

ex:Lighting a ex:LightingCondition ;
    ex:isType ex:OverheadTunnelLighting ;
    ex:hasIlluminationLevel ex:Low .

ex:RoadSurface a ex:RoadInfrastructure ;
    ex:hasMarkings ex:LaneMarkings .

ex:EgoVehicle ex:hasRisk ex:LowVisibilityRisk, ex:BlindSpotRisk .
ex:DistantVehicle ex:hasRisk ex:SuddenBrakingRisk .
```

