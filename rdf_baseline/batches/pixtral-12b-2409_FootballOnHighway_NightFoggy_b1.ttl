    ex:hasMaterial "asphalt" ;
    ex:hasVisibility "low" .

ex:Streetlight1 a ex:Streetlight ;
    ex:illuminates ex:RoadSurface1 ;
    ex:causesGlare "high" .

ex:Streetlight2 a ex:Streetlight ;
    ex:illuminates ex:Sidewalk1 ;
    ex:causesGlare "moderate" .

ex:Sidewalk1 a ex:Sidewalk ;
    ex:adjacentTo ex:RoadSurface1 ;
    ex:hasVisibility "low" .

ex:NighttimeCondition a ex:WeatherCondition ;
    ex:ambientLight "dark" ;
    ex:hasPrecipitation "none" .

ex:PotentialIntersection1 a ex:Intersection ;
    ex:hasVisibility "occluded" ;
    ex:hasPotentialAgents "unknown" .
