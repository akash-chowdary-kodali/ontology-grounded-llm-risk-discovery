### **Scene Description in RDF Triples (Turtle Format)**
```turtle
@prefix ex: <http://example.org/autonomous-driving#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

ex:Scene1 a ex:AutonomousDrivingScene ;
    ex:hasWeatherCondition ex:Nighttime ;
    ex:hasLightingCondition ex:LowAmbientLightWithStreetlights .

ex:EgoVehicle a ex:Vehicle ;
    ex:hasPosition "CenterLeftLane" ;
    ex:hasSpeed "Slow" ;
    ex:hasHeadlightsOn true ;
    ex:isFollowing ex:Motorcycle .

ex:Motorcycle a ex:Vehicle ;
    ex:hasPosition "CenterOfLane" ;
    ex:hasSpeed "SlowOrStationary" ;
    ex:isOccludedBy ex:OverheadStructure ;
    ex:isApproachedBy ex:EgoVehicle .

ex:RoadMarkings a ex:RoadInfrastructure ;
    ex:hasType "DoubleWhiteLines" ;
    ex:hasType "DashedLines" .

ex:OverheadStructure a ex:RoadInfrastructure ;
    ex:hasMaterial "WoodenBeams" ;
    ex:occludes ex:Motorcycle .

ex:Streetlight a ex:RoadInfrastructure ;
    ex:illuminates ex:Motorcycle ;
    ex:illuminates ex:RoadMarkings .

ex:LargeCylindricalObject a ex:Obstacle ;
    ex:hasPosition "RightSideOfRoad" ;
    ex:hasType "StorageTankOrPillar" .
```

