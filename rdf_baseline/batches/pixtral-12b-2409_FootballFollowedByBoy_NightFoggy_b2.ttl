```plaintext
Scene Description in RDF Triples (Turtle Format)
```

```turtle
@prefix ex: <http://example.org/autonomous-driving#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Scene1 a ex:DrivingScene ;
    ex:timeStamp "2023-10-05T23:47:00"^^xsd:dateTime ;
    ex:location ex:UrbanStreetCorner .

ex:Pedestrian1 a ex:Pedestrian ;
    ex:location ex:StreetRightSidewalk ;
    ex:position "30.5m from camera, right side" ;
    ex:action ex:CrossingRoad .

ex:Road1 a ex:Road ;
    ex:hasCurve true ;
    ex:surfaceCondition ex:Dry ;
    ex:lightCondition ex:LowLight .

ex:Vehicle1 a ex:AutonomousVehicle ;
    ex:position "0m from camera, center" ;
    ex:action ex:ApproachingCurve ;
    ex:hasSensorData ex:LidarCameraData .

ex:Obstacle1 a ex:Obstacle ;
    ex:location ex:RoadCenter ;
    ex:type ex:SoccerBall ;
    ex:distanceFromVehicle "15m" .

ex:Tree1 a ex:Infrastructure ;
    ex:location ex:RoadsideRight ;
    ex:type ex:Tree ;
    ex:occlusionLevel ex:Partial .

ex:Pedestrian1 ex:near ex:Obstacle1 .
ex:Vehicle1 ex:approaching ex:Pedestrian1 .
ex:Vehicle1 ex:near ex:Obstacle1 .
ex:Tree1 ex:occluding ex:Pedestrian1 .
ex:Pedestrian1 ex:crossing ex:Road1 .
```

