ex:Risk1 a ex:Risk ;
    ex:riskDescription "Reduced visibility due to rain and nighttime conditions" ;
    ex:severityScore "0.85" ;
    ex:riskClass ex:VisibilityRisk .

ex:Risk2 a ex:Risk ;
    ex:riskDescription "Wet road surface leading to decreased traction" ;
    ex:severityScore "0.80" ;
    ex:riskClass ex:RoadConditionRisk .

ex:Risk3 a ex:Risk ;
    ex:riskDescription "Headlight glare and reflections on wet surfaces" ;
    ex:severityScore "0.75" ;
    ex:riskClass ex:LightingRisk .

ex:Risk4 a ex:Risk ;
    ex:riskDescription "Scattered debris on the road" ;
    ex:severityScore "0.70" ;
    ex:riskClass ex:ObstacleRisk .

ex:Risk5 a ex:Risk ;
    ex:riskDescription "Low visibility of pedestrians" ;
    ex:severityScore "0.80" ;
