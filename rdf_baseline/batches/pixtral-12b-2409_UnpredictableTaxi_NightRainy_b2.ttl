    ex:riskClass ex:FollowingRisk .

ex:Risk7 a ex:Risk ;
    ex:riskDescription "Misjudging distances and speeds" ;
    ex:severityScore "0.85" ;
    ex:riskClass ex:JudgmentRisk .
