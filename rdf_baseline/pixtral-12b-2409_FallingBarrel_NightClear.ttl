    ex:isType ex:TrafficCone ;
    ex:isNear ex:WhiteVan .

ex:CylindricalBarriers a ex:Obstacle ;
    ex:isType ex:CylindricalBarrier ;
    ex:partiallyBlocks ex:Road .

