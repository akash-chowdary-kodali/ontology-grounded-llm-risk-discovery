```turtle
@prefix : <http://example.org/autonomous-driving#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Scene1 a :AutonomousDrivingScene ;
    :hasWeatherCondition :Nighttime ;
    :hasLightingCondition :StreetlightIllumination .

:EgoVehicle a :Vehicle ;
    :hasColor "Red" ;
    :hasPosition :FrontOfScene ;
    :isFollowing :BlackSUV .

:BlackSUV a :Vehicle ;
    :hasColor "Black" ;
    :hasPosition :RightLane ;
    :isFollowing :YellowTaxi .

:YellowTaxi a :Vehicle ;
    :hasColor "Yellow" ;
    :hasPosition :RightLane ;
    :isApproaching :Intersection .

:Intersection a :RoadInfrastructure ;
    :hasTrafficSignal :RedLight ;
    :hasRoadMarkings :DoubleWhiteLines .

:TrafficSignal a :RoadInfrastructure ;
    :hasColor "Red" ;
    :isLocatedAt :Intersection .

:Streetlight a :LightSource ;
    :illuminates :Road ;
    :isPresent true .

:Building a :Infrastructure ;
    :isAdjacentTo :Sidewalk .

:Sidewalk a :RoadInfrastructure ;
    :isAdjacentTo :Building .
```

