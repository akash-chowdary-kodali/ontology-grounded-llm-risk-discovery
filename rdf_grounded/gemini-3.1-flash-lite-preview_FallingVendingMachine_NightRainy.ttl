Scene Description in RDF Triples (Turtle Format)
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "FallingBillboardOnRoadway" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasActor :actor1 ;
    :hasObstacle :obs1 ;
    :hasWeatherCondition :weather1 ;
    :hasEvidence :ind1 ;
    :hasRisk :risk1 .

:actor1 a :Vehicle .
:obs1 a :RoadObject ;
    :description "Falling advertising billboard obstructing lane" .
:weather1 a :RainyCondition .
:ind1 a :FallingObjectIndicator ;
    :indicatesPotentialRisk :risk1 .

:risk1 a :CollisionRisk ;
    :description "High speed collision with fallen billboard in low visibility conditions" ;
    :hasSeverityScore :sev1 ;
    :confidenceScore "0.95"^^xsd:float .

:sev1 a :SeverityScore ;
    :severityValue "0.92"^^xsd:float .

