```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Dark Rainy Urban Environment" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1 ;
    :hasObstacle :obstacle1 .
    
:weather1 a :RainyCondition .

:obstacle1 a :RoadObject ;
    :description "Water pooled on the road surface due to rain" .

:risk1 a :RoadConditionRisk ;
    :description "Wet road leading to potential loss of traction" ;
    :hasSeverityScore :sev1 .

:sev1 a :SeverityScore ;
    :severityValue "0.7"^^xsd:float .

```

