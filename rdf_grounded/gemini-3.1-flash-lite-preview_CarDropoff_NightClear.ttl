Scene Description in RDF Triples (Turtle Format)
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "NighttimeVehicleOcclusion" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :occursInScene :scene1 ;
    :hasActor :vehicle1, :vehicle2 ;
    :hasWeatherCondition :night1 ;
    :hasRisk :risk1 .

:vehicle1 a :Vehicle ;
    :description "Ego vehicle" .

:vehicle2 a :Vehicle ;
    :description "Parked vehicle obstructing view of curb area" .

:night1 a :NightCondition .

:risk1 a :OcclusionRisk ;
    :description "Parked vehicle creating blind spot near bus stop area at night" ;
    :hasSeverityScore :sev1 ;
    :confidenceScore "0.75"^^xsd:float .

:sev1 a :SeverityScore ;
    :severityValue "0.60"^^xsd:float .

