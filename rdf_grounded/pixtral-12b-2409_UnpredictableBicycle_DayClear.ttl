    :indicatesPotentialRisk :risk1 .

:obstacle1 a :RoadObject ;
    :description "Grey suitcase falling from vehicle roof" .

:risk1 a :CollisionRisk ;
    :description "Risk of collision due to falling suitcase" ;
    :hasSeverityScore :sev1 .

:risk2 a :DistractionRisk ;
    :description "Driver distraction risk due to handling falling object" ;
    :hasSeverityScore :sev2 .

:weather1 a :ClearCondition ;
    :description "Clear weather with daylight" .

