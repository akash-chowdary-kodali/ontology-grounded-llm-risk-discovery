Scene Description in RDF Triples (Turtle Format)
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "NighttimeUrbanDoorOpening" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasActor :actor1 ;
    :hasEvidence :indicator1 ;
    :hasWeatherCondition :rainy1 ;
    :hasRisk :risk1 .

:actor1 a :Vehicle ;
    :description "Parked vehicle with an opening door" .

:indicator1 a :OpenDoorIndicator ;
    :indicatesPotentialRisk :risk1 .

:rainy1 a :RainyCondition .

:risk1 a :LaneIntrusionRisk ;
    :description "Vehicle door opening into the travel lane at night in rainy conditions" ;
    :hasSeverityScore :sev1 ;
    :confidenceScore "0.95"^^xsd:float .

:sev1 a :SeverityScore ;
    :severityValue "0.80"^^xsd:float .

