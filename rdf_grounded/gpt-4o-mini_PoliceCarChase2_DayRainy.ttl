```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Driving in Rainy Conditions with Road Objects" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasWeatherCondition :weather1 ;
    :hasObstacle :roadObject1 ;
    :hasRisk :risk1 .

:roadObject1 a :RoadObject ;
    :description "Multiple vehicles on the road" .

:weather1 a :RainyCondition .

:risk1 a :DistractionRisk ;
    :description "Visibility reduced due to rain and road objects" ;
    :hasSeverityScore :sev1 .

:sev1 a :SeverityScore ;
    :severityValue "0.7"^^xsd:float .
