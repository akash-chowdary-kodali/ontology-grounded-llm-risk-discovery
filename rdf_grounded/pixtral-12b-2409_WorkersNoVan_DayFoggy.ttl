```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "FoggyRoadConstructionWorkers" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasActor :actor1, :actor2 ;
    :hasObstacle :obstacle1, :obstacle2, :obstacle3 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1, :risk2, :risk3 ;
    :hasEvidence :evidence1 .

:actor1 a :Pedestrian ;
    :description "Construction worker near road barrier" .
:actor2 a :Pedestrian ;
    :description "Construction worker walking on road" .

:obstacle1 a :RoadObject ;
    :description "Large concrete barrier on roadside" .
:obstacle2 a :RoadObject ;
    :description "Orange traffic cone" .
:obstacle3 a :RoadObject ;
    :description "Construction equipment on roadside" .

:weather1 a :FoggyCondition ;
    :description "Heavy fog reducing visibility" .

:evidence1 a :RollingBallIndicator ;
    :description "Orange cones indicate rolling hazard" ;
    :indicatesPotentialRisk :risk2 .

:risk1 a :PedestrianCollisionRisk ;
    :description "Construction worker walking into vehicle path" ;
    :hasSeverityScore :sev1 .

:risk2 a :OcclusionRisk ;
    :description "Heavy fog obscuring visibility of road" ;
    :hasSeverityScore :sev2 .

:risk3 a :LaneIntrusionRisk ;
    :description "Construction equipment intruding into driving lane" ;
    :hasSeverityScore :sev3 .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.85"^^xsd:float .

:sev3 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .
```

