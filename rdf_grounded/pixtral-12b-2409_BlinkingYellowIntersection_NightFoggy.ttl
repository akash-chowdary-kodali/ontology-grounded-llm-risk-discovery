### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "NighttimeIntersectionWithTrafficLights" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasActor :vehicle1, :vehicle2 ;
    :hasWeatherCondition :nightCondition ;
    :hasRisk :risk1, :risk2 ;
    :hasEvidence :evidence1 .

:vehicle1 a :Vehicle ;
    :description "Orange car approaching intersection" .

:vehicle2 a :Vehicle ;
    :description "Black car approaching intersection from left" .

:nightCondition a :NightCondition ;
    :description "Low visibility due to nighttime" .

:risk1 a :RearEndCollisionRisk ;
    :description "Potential rear-end collision due to vehicles approaching intersection simultaneously" ;
    :hasSeverityScore :sev1 .

:risk2 a :DistractionRisk ;
    :description "Driver distraction risk due to low visibility at night" ;
    :hasSeverityScore :sev2 .

:evidence1 a :RollingBallIndicator ;
    :description "Low visibility and headlight reflections indicate potential distraction risk" ;
    :indicatesPotentialRisk :risk2 .

:sev1 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.60"^^xsd:float .

:trafficLight1 a :TrafficLight ;
    :description "Yellow traffic light at intersection" .
:trafficLight2 a :TrafficLight ;
    :description "Yellow traffic light at intersection (opposite side)" .
```

