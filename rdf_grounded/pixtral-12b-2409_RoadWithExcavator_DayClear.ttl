@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "ConstructionVehicleWithLooseObject" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasActor :vehicle1 ;
    :hasObstacle :roadObject1 ;
    :hasEvidence :evidence1 ;
    :hasRisk :risk1, :risk2 ;
    :hasWeatherCondition :weather1 .

:vehicle1 a :Vehicle ;
    :description "Construction vehicle with extended arm and bucket" .

:roadObject1 a :RoadObject ;
    :description "Loose object (orange traffic cone) near construction vehicle" .

:evidence1 a :FallingObjectIndicator ;
    :description "Orange traffic cone positioned precariously near vehicle bucket" ;
    :indicatesPotentialRisk :risk1 .

:weather1 a :DayCondition ;
    :description "Clear daytime conditions" .

:risk1 a :CollisionRisk ;
    :description "Risk of collision due to loose traffic cone rolling into path" ;
    :hasSeverityScore :sev1 .

:risk2 a :OcclusionRisk ;
    :description "Risk of occlusion due to construction vehicle arm blocking view of surroundings" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.60"^^xsd:float .
```

