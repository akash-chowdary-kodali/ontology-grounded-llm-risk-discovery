@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Nighttime Urban Parking Lot with Wet Road" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasObstacle :roadObject1 ;
    :hasWeatherCondition :nightCondition ;
    :hasRisk :risk1, :risk2 ;
    :hasEvidence :evidence1 .

:roadObject1 a :RoadObject ;
