    :indicatesPotentialRisk :risk2 .

:risk1 a :OcclusionRisk ;
    :description "Limited visibility due to nighttime and artificial lighting shadows" ;
    :hasSeverityScore :sev1 .

:risk2 a :RoadConditionRisk ;
    :description "Slippery road surface due to wet conditions" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
