```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "UrbanTrafficScenario" ;
    :hasCornerCaseType :cc1 .

:cc1 a :BehaviorAnomaly ;
    :hasActor :actor1 ;
    :hasRisk :risk1 .

:actor1 a :Vehicle ;  # Yellow taxi
    :description "Yellow taxi driving on the road" .

:risk1 a :RearEndCollisionRisk ;
    :description "Risk of rear-end collision due to close proximity" ;
    :hasSeverityScore :sev1 .

:sev1 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .
