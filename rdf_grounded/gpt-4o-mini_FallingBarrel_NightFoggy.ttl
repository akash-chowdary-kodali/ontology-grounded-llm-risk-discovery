```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Night scenario with obstacles in fog" ;
    :hasCornerCaseType :cc1 .
:cc1 a :StateAnomaly ;
    :hasActor :actor1 ;
    :hasObstacle :obstacle1 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1 .
:actor1 a :Pedestrian .
:obstacle1 a :RoadObject .
:weather1 a :FoggyCondition .
:risk1 a :CollisionRisk ;
    :description "Risk of collision with a pedestrian near an obstacle" ;
    :hasSeverityScore :sev1 .
:sev1 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:risk2 a :LaneIntrusionRisk ;
    :description "Potential lane intrusion due to falling object" ;
    :hasSeverityScore :sev2 .
:sev2 a :SeverityScore ;
    :severityValue "0.60"^^xsd:float .

:risk3 a :DistractionRisk ;
    :description "Driver distraction due to sudden appearance of obstacles" ;
    :hasSeverityScore :sev3 .
:sev3 a :SeverityScore ;
    :severityValue "0.50"^^xsd:float .
