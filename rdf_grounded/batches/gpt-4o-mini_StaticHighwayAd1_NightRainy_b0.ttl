```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Nighttime rainy street with limited visibility" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1 ;
    :hasObstacle :obstacle1 .

:weather1 a :RainyCondition .

:obstacle1 a :RoadObject ;
    :description "Wet road with low visibility due to rain" .

:risk1 a :WeatherRisk ;
    :description "Rainy conditions leading to slippery roads and decreased visibility" ;
    :hasSeverityScore :sev1 .

:sev1 a :SeverityScore ;
    :severityValue "0.70"^^xsd:float .
```

