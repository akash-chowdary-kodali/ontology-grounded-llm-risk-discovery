### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "UrbanIntersectionWithBillboards" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasObstacle :billboard1, :billboard2 ;
    :hasEvidence :evidence1 ;
    :hasRisk :risk1, :risk2 ;
    :hasWeatherCondition :weather1 .

:billboard1 a :Billboard ;
    :description "Left-side billboard with directional sign and advertisement" .
:billboard2 a :Billboard ;
    :description "Right-side billboard with advertisement" .

:evidence1 a :DistractionRisk ;
    :description "Multiple billboards may distract drivers" ;
    :indicatesPotentialRisk :risk1 .

:weather1 a :DayCondition ;
    :description "Clear daytime conditions" .

:risk1 a :DistractionRisk ;
    :description "High visual clutter from billboards may cause driver distraction" ;
    :hasSeverityScore :sev1 ;
    :confidenceScore "0.75"^^xsd:float .

:risk2 a :OcclusionRisk ;
    :description "Billboards may partially obscure traffic signs or pedestrians" ;
    :hasSeverityScore :sev2 ;
    :confidenceScore "0.60"^^xsd:float .

:sev1 a :SeverityScore ;
    :severityValue "0.70"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.55"^^xsd:float .
```

