### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "NighttimeWetRoadWithNoEntrySign" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasWeatherCondition :weather1 ;
    :hasObstacle :obstacle1 ;
    :hasRisk :risk1, :risk2, :risk3 ;
    :hasEvidence :evidence1 .

:weather1 a :NightCondition, :RainyCondition ;
    :description "Dark night with wet road surface" .

:obstacle1 a :RoadObject ;
    :description "No entry sign on right side of road" .

:evidence1 a :RollingBallIndicator ;
    :description "Water puddles and reflective road surface indicating wet conditions" ;
    :indicatesPotentialRisk :risk2 .

:risk1 a :OcclusionRisk ;
    :description "Reduced visibility due to nighttime and potential rain" ;
    :hasSeverityScore :sev1 .

:risk2 a :RoadConditionRisk ;
    :description "Slippery road surface due to rain" ;
    :hasSeverityScore :sev2 .

:risk3 a :DistractionRisk ;
    :description "Bright billboard may distract driver" ;
    :hasSeverityScore :sev3 .

:sev1 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.80"^^xsd:float .

:sev3 a :SeverityScore ;
    :severityValue "0.50"^^xsd:float .
```

