```
Scene Description in RDF Triples (Turtle Format)
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "UrbanBridgeTrafficWithLaneIntrusion" ;
    :hasCornerCaseType :cc1 .

:cc1 a :BehaviorAnomaly ;
    :hasActor :vehicle1, :vehicle2 ;
    :hasObstacle :bridgeStructure ;
    :hasRisk :risk1, :risk2, :risk3 ;
    :hasWeatherCondition :weather1 .

:vehicle1 a :Vehicle ;
    :description "Black vehicle in left lane with potential lane intrusion" .

:vehicle2 a :Vehicle ;
    :description "Red vehicle in right lane, partially visible" .

:bridgeStructure a :RoadObject ;
    :description "Overhead bridge structure with traffic lights" .

:weather1 a :DayCondition, :ClearCondition .

:risk1 a :LaneIntrusionRisk ;
    :description "Black vehicle in left lane may intrude into adjacent lane" ;
    :hasSeverityScore :sev1 .

:risk2 a :RearEndCollisionRisk ;
    :description "Potential rear-end collision risk due to traffic congestion under bridge" ;
    :hasSeverityScore :sev2 .

:risk3 a :OcclusionRisk ;
    :description "Occlusion risk from bridge structure obstructing view of traffic ahead" ;
    :hasSeverityScore :sev3 .

:sev1 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.60"^^xsd:float .

:sev3 a :SeverityScore ;
    :severityValue "0.55"^^xsd:float .

