### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Nighttime Wet Road with Potential Falling Object" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasEvidence :evidence1 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1 ;
    :hasRisk :risk2 .

:evidence1 a :FallingObjectIndicator ;
    :description "Reflective glint and splash pattern suggesting falling object (e.g., debris) on wet road" ;
    :indicatesPotentialRisk :risk1 .

:weather1 a :NightCondition ;
    :description "Low-light conditions with wet road surface" .

:risk1 a :CollisionRisk ;
    :description "Potential collision risk due to falling object on road" ;
    :hasSeverityScore :sev1 .

:risk2 a :RoadConditionRisk ;
    :description "Slippery road conditions due to wet surface" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.60"^^xsd:float .
```

