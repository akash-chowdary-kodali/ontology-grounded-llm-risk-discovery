```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Nighttime roadway with billboards" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1 ;
    :hasObstacle :obstacle1 .

:weather1 a :NightCondition .

:obstacle1 a :Billboard ;
    :description "Presence of billboards on the roadside"^^xsd:string .

:risk1 a :DistractionRisk ;
    :description "Potential distraction from bright billboards while driving" ;
    :hasSeverityScore :sev1 .

:sev1 a :SeverityScore ;
    :severityValue "0.6"^^xsd:float .
