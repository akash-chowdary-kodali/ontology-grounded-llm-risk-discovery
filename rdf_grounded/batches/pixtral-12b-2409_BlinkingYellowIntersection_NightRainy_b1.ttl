@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Nighttime Urban Intersection with Wet Road" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :description "Wet road surface with potential hydroplaning risk and rear-end collision risk due to reduced visibility and braking distance" ;
    :hasWeatherCondition :weather1 ;
    :hasObstacle :obstacle1 ;
    :hasRisk :risk1, :risk2 ;
