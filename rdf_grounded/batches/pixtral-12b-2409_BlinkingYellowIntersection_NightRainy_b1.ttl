    :indicatesPotentialRisk :risk1 .

:risk1 a :RearEndCollisionRisk ;
    :description "High risk of rear-end collision due to wet road reducing braking efficiency and visibility" ;
    :hasSeverityScore :sev1 .

:risk2 a :RoadConditionRisk ;
    :description "Hydroplaning risk due to wet road surface" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.85"^^xsd:float .

:vehicle1 a :Vehicle ;
