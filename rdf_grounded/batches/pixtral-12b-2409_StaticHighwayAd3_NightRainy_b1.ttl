@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "NighttimeWetRoadWithSpeedLimit" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasObstacle :roadObject1 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1, :risk2 ;
    :description "Wet road surface with reduced visibility due to nighttime conditions and potential hydroplaning risk." .

:roadObject1 a :RoadObject ;
    :description "Wet road surface with reflective sheen indicating recent rain." .

:weather1 a :NightCondition ;
    :description "Nighttime with low ambient light and wet road conditions." .

:risk1 a :RoadConditionRisk ;
    :description "High risk of hydroplaning due to wet road surface" ;
    :hasSeverityScore :sev1 .

:sev1 a :SeverityScore ;
    :severityValue "0.9"^^xsd:float .

:risk2 a :OcclusionRisk ;
    :description "Reduced visibility of road signs and potential obstacles due to nighttime and rain" ;
    :hasSeverityScore :sev2 .

:sev2 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:trafficSign1 a :TrafficSign ;
    :description "Speed limit sign (90 km/h) partially obscured by nighttime conditions" .

:billboard1 a :Billboard ;
    :description "Billboard with no clear content visible due to lighting and distance" .
```

