```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Construction Site Near Road" ;
    :hasCornerCaseType :cc1 .

:cc1 a :BehaviorAnomaly ;
    :hasActor :actor1 ;
    :hasActor :actor2 ;
    :hasObstacle :obstacle1 ;
    :hasRisk :risk1 ;
    :hasRisk :risk2 ;
    :hasWeatherCondition :weather1 .

:actor1 a :Pedestrian .
:actor2 a :Pedestrian .

:obstacle1 a :RoadObject .

:weather1 a :ClearCondition .

:risk1 a :PedestrianCollisionRisk ;
    :description "Pedestrian walking near moving vehicles." ;
    :hasSeverityScore :sev1 .

:risk2 a :LaneIntrusionRisk ;
    :description "Obstruction on the road with traffic cones." ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.60"^^xsd:float .
```

