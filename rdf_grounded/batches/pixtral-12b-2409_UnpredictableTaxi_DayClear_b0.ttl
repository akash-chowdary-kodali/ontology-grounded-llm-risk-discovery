:risk1 a :RearEndCollisionRisk ;
    :description "High risk of rear-end collision due to close following distance and obscured rear view" ;
    :hasSeverityScore :sev1 .

:risk2 a :OcclusionRisk ;
    :description "Occlusion risk from taxi's rear door and road markings obstructing sensor/visual perception" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
    :severityValue "0.92"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.78"^^xsd:float .
