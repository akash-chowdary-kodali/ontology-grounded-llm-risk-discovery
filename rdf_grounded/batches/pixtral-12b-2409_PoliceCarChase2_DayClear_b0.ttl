:risk2 a :LaneIntrusionRisk ;
    :description "Vehicles in adjacent lanes may intrude due to construction zone" ;
    :hasSeverityScore :sev2 .

:risk3 a :RearEndCollisionRisk ;
    :description "Potential rear-end collision risk due to reduced visibility under bridge" ;
    :hasSeverityScore :sev3 .

:sev1 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:sev2 a :SeverityScore ;
