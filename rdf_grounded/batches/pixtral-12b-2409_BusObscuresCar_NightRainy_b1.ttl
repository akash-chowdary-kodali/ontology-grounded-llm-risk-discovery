### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "NighttimeUrbanIntersectionWithWetRoad" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :description "Wet road conditions with potential hydroplaning risk and reduced visibility due to nighttime" ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1, :risk2, :risk3 ;
    :hasObstacle :roadObject1 .

:weather1 a :NightCondition ;
    :description "Nighttime with artificial lighting" .

:roadObject1 a :RoadObject ;
    :description "Puddles on the road surface" .

:risk1 a :RoadConditionRisk ;
    :description "Hydroplaning risk due to wet road surface" ;
    :hasSeverityScore :sev1 .

:risk2 a :OcclusionRisk ;
    :description "Reduced visibility due to nighttime and reflections on wet road" ;
    :hasSeverityScore :sev2 .

:risk3 a :CollisionRisk ;
    :description "Potential rear-end collision risk due to reduced traction and braking distance" ;
    :hasSeverityScore :sev3 .

:sev1 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.65"^^xsd:float .

:sev3 a :SeverityScore ;
    :severityValue "0.80"^^xsd:float .

:vehicle1 a :Vehicle ;
    :description "Yellow vehicle in front" .

:vehicle2 a :Vehicle ;
    :description "Gray vehicle in front of ego vehicle" .
```

