Scene Description in RDF Triples (Turtle Format)
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Cyclist_Collision_Nighttime" ;
    :hasCornerCaseType :cc1 .

:cc1 a :BehaviorAnomaly ;
    :occursInScene :scene1 ;
    :hasActor :cyclist1 ;
    :hasWeatherCondition :night1 ;
    :hasRisk :risk1 .

:cyclist1 a :Cyclist .
:night1 a :NightCondition .

:risk1 a :CollisionRisk ;
    :description "Cyclist crossing vehicle path at night with potential for collision" ;
    :hasSeverityScore :sev1 .

:sev1 a :SeverityScore ;
    :severityValue "0.95"^^xsd:float .

