### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "NighttimeIntersectionWithReducedVisibility" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1, :risk2, :risk3 ;
    :hasObstacle :obstacle1 .

:weather1 a :NightCondition ;
    :description "Low-light conditions with foggy visibility" .

:risk1 a :OcclusionRisk ;
    :description "Reduced visibility due to nighttime and potential fog" ;
    :hasSeverityScore :sev1 .

:risk2 a :WeatherRisk ;
    :description "Foggy conditions affecting road visibility" ;
    :hasSeverityScore :sev2 .

:risk3 a :DistractionRisk ;
    :description "Potential distraction from wet road reflections" ;
    :hasSeverityScore :sev3 .

:obstacle1 a :RoadObject ;
    :description "Wet road surface with reflective glare" .

:sev1 a :SeverityScore ;
    :severityValue "0.9"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.85"^^xsd:float .

:sev3 a :SeverityScore ;
    :severityValue "0.6"^^xsd:float .

:trafficLight1 a :TrafficLight ;
    :description "Green traffic light at intersection" .

:billboard1 a :Billboard ;
    :description "Billboard on right side of intersection" .

:trafficSign1 a :TrafficSign ;
    :description "No entry sign on right side of intersection" .
```

