Scene Description in RDF Triples (Turtle Format)
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Tunnel_Vehicle_LaneIntrusion" ;
    :hasCornerCaseType :cc1 .

:cc1 a :BehaviorAnomaly ;
    :hasActor :vehicle1 ;
    :hasWeatherCondition :rainy1 ;
    :hasRisk :risk1 .

:vehicle1 a :Vehicle .
:rainy1 a :RainyCondition .

:risk1 a :LaneIntrusionRisk ;
    :description "Vehicle performing an emergency swerve or loss of control maneuver across lanes in a tunnel" ;
    :confidenceScore "0.92"^^xsd:float ;
    :hasSeverityScore :sev1 .

:sev1 a :SeverityScore ;
    :severityValue "0.88"^^xsd:float .

