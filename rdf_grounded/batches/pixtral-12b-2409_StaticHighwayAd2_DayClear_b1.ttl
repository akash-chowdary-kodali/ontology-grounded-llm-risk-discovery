### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "UrbanIntersectionWithBillboards" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasObstacle :billboard1 ;
    :hasObstacle :billboard2 ;
    :hasRisk :risk1 ;
    :hasRisk :risk2 ;
    :hasWeatherCondition :weather1 .

:billboard1 a :Billboard ;
    :description "Hungry billboard with food images" .
:billboard2 a :Billboard ;
    :description "Pharmacy billboard with 'Dr. CARLE'" .

:weather1 a :DayCondition ;
    :description "Clear daytime with no precipitation" .

:risk1 a :DistractionRisk ;
    :description "Billboards may distract driver attention" ;
    :hasSeverityScore :sev1 .

:risk2 a :OcclusionRisk ;
    :description "Billboards partially obscure visibility of road signs" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
    :severityValue "0.65"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.50"^^xsd:float .
```

