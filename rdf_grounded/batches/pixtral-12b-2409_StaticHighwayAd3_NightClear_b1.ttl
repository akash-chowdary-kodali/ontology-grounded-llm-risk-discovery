### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Nighttime Highway Exit with Electronic Signage" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasEvidence :evidence1 ;
    :hasObstacle :obstacle1 ;
    :hasRisk :risk1, :risk2 ;
    :hasWeatherCondition :weather1 .

:evidence1 a :RollingBallIndicator ;
    :description "Electronic sign displaying dynamic traffic information (e.g., speed limit changes)" ;
    :indicatesPotentialRisk :risk1 .

:obstacle1 a :RoadObject ;
    :description "Electronic billboard displaying variable speed limit (90 km/h)" .

:risk1 a :DistractionRisk ;
    :description "Driver distraction due to electronic signage displaying dynamic traffic information" ;
    :hasSeverityScore :sev1 .

:risk2 a :RoadConditionRisk ;
    :description "Potential confusion from conflicting or rapidly changing speed limit signs" ;
    :hasSeverityScore :sev2 .

:weather1 a :NightCondition ;
    :description "Low-light conditions affecting visibility of signs and road markings" .

:sev1 a :SeverityScore ;
    :severityValue "0.65"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.70"^^xsd:float .

:billboard1 a :Billboard ;
    :description "Electronic billboard displaying dynamic traffic information (e.g., speed limit changes)" .

:trafficSign1 a :TrafficSign ;
    :description "Permanent traffic sign indicating no parking" .

:trafficLight1 a :TrafficLight ;
    :description "Traffic light system (visible in background but not active in this scene)" .
```

