Scene Description in RDF Triples (Turtle Format)
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "PedestrianSuddenCrossing" ;
    :hasCornerCaseType :cc1 .

:cc1 a :BehaviorAnomaly ;
    :occursInScene :scene1 ;
    :hasActor :pedestrian1 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1 .

:pedestrian1 a :Pedestrian .
:weather1 a :ClearCondition .

:risk1 a :PedestrianCollisionRisk ;
    :description "Pedestrian walking into the vehicle path from behind a parked van" ;
    :confidenceScore "0.95"^^xsd:float ;
    :hasSeverityScore :sev1 .

:sev1 a :SeverityScore ;
    :severityValue "0.92"^^xsd:float .

