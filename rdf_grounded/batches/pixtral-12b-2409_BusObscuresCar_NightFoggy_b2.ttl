```
Scene Description in RDF Triples (Turtle Format)
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "NighttimeUrbanCurveDriving" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasObstacle :vehicle1, :vehicle2 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1, :risk2, :risk3 .

:vehicle1 a :Vehicle ;
    :description "Black vehicle in front of ego vehicle" .
:vehicle2 a :Vehicle ;
    :description "Yellow vehicle approaching from opposite direction" .

:weather1 a :NightCondition .

:risk1 a :RearEndCollisionRisk ;
    :description "Potential rear-end collision risk due to following distance and vehicle speed" ;
    :hasSeverityScore :sev1 ;
    :confidenceScore "0.75"^^xsd:float .

:risk2 a :LaneIntrusionRisk ;
    :description "Potential lane intrusion risk due to curve visibility and vehicle positioning" ;
    :hasSeverityScore :sev2 ;
    :confidenceScore "0.60"^^xsd:float .

:risk3 a :OcclusionRisk ;
    :description "Potential occlusion risk due to limited visibility around the curve" ;
    :hasSeverityScore :sev3 ;
    :confidenceScore "0.70"^^xsd:float .

:sev1 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.60"^^xsd:float .

:sev3 a :SeverityScore ;
    :severityValue "0.70"^^xsd:float .
```

```
Identified Risks for each risk class
