:vehicle3 a :Vehicle ;
    :description "Yellow taxi vehicle on right lane" .

:rainy1 a :RainyCondition ;
    :description "Heavy rain reducing visibility" .

:roadCondition1 a :RoadObject ;
    :description "Wet road surface with standing water" .

:risk1 a :RearEndCollisionRisk ;
    :description "High risk of rear-end collision due to slow-moving traffic and reduced visibility" ;
    :hasSeverityScore :sev1 ;
    :confidenceScore "0.92"^^xsd:float .

:risk2 a :RoadConditionRisk ;
    :description "Risk of hydroplaning or loss of vehicle control due to wet road conditions" ;
    :hasSeverityScore :sev2 ;
    :confidenceScore "0.88"^^xsd:float .

:risk3 a :OcclusionRisk ;
    :description "Risk of occlusion due to heavy rain and limited visibility of other vehicles" ;
    :hasSeverityScore :sev3 ;
    :confidenceScore "0.85"^^xsd:float .

:sev1 a :SeverityScore ;
    :severityValue "0.95"^^xsd:float .

:sev2 a :SeverityScore ;
