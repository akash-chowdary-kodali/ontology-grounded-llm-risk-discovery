### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "UrbanNightTrafficCongestionWithHeavyRain" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasObstacle :obstacle1 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1, :risk2, :risk3 ;
    :hasEvidence :evidence1 .

:obstacle1 a :RoadObject ;
    :description "Traffic congestion with multiple vehicles occupying multiple lanes" .

:weather1 a :RainyCondition ;
    :description "Heavy rain reducing visibility and road traction" .

:evidence1 a :RollingBallIndicator ;
    :description "Water droplets on road surface indicating heavy rain and potential hydroplaning" ;
    :indicatesPotentialRisk :risk3 .

:risk1 a :RearEndCollisionRisk ;
    :description "High risk of rear-end collision due to heavy traffic and reduced visibility" ;
    :hasSeverityScore :sev1 .

:risk2 a :RoadConditionRisk ;
    :description "Slippery road conditions due to heavy rain, increasing skid and hydroplaning risks" ;
    :hasSeverityScore :sev2 .

:risk3 a :OcclusionRisk ;
    :description "Reduced visibility due to heavy rain and water droplets, increasing risk of missing obstacles" ;
    :hasSeverityScore :sev3 .

:sev1 a :SeverityScore ;
    :severityValue "0.92"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.88"^^xsd:float .

:sev3 a :SeverityScore ;
    :severityValue "0.85"^^xsd:float .

:vehicle1 a :Vehicle ;
    :description "Yellow taxi in front lane, partially obstructing view" .

:vehicle2 a :Vehicle ;
    :description "Yellow taxi in adjacent lane, contributing to congestion" .
```

