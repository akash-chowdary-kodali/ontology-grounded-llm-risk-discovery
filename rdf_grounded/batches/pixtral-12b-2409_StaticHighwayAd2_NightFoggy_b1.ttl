@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "NighttimeRoadWithBillboardAndSpeedLimitSign" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :description "Nighttime road with low visibility due to foggy conditions and potential distraction from billboards" ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1, :risk2, :risk3 ;
    :hasObstacle :obstacle1 .

:weather1 a :FoggyCondition .

:risk1 a :DistractionRisk ;
    :description "Bright billboards may distract driver attention" ;
    :hasSeverityScore :sev1 .

:risk2 a :OcclusionRisk ;
    :description "Fog reduces visibility of road signs and potential obstacles" ;
    :hasSeverityScore :sev2 .

:risk3 a :RoadConditionRisk ;
    :description "Wet or reflective road surface may affect vehicle traction" ;
    :hasSeverityScore :sev3 .

:sev1 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.80"^^xsd:float .

:sev3 a :SeverityScore ;
    :severityValue "0.60"^^xsd:float .

:obstacle1 a :RoadObject ;
    :description "Speed limit sign (90 km/h) partially obscured by fog" .

:billboard1 a :Billboard ;
    :description "Restaurant advertisement billboard on left side of road" .

:speedLimitSign1 a :TrafficSign ;
    :description "Speed limit sign (90 km/h) partially visible" .
```

