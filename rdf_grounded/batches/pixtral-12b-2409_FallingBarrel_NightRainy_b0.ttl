### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Nighttime Pedestrian Near Parked Vehicle with Road Obstacles" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasActor :actor1, :actor2 ;
    :hasObstacle :obstacle1, :obstacle2 ;
    :hasEvidence :evidence1 ;
    :hasRisk :risk1, :risk2, :risk3 ;
    :hasWeatherCondition :weather1 .

:actor1 a :Pedestrian ;
    :description "Person standing near parked vehicle on roadside" .

:actor2 a :Vehicle ;
    :description "Parked van with open rear door" .

:obstacle1 a :RoadObject ;
    :description "Fallen tree branch lying across road" .

:obstacle2 a :RoadObject ;
    :description "Orange traffic cone near roadside" .

:evidence1 a :FallingObjectIndicator ;
    :description "Fallen tree branch obstructing road" ;
    :indicatesPotentialRisk :risk1 .

:weather1 a :NightCondition .

:risk1 a :OcclusionRisk ;
    :description "Fallen tree branch partially blocking road visibility" ;
    :hasSeverityScore :sev1 .

:risk2 a :PedestrianCollisionRisk ;
    :description "Pedestrian standing too close to moving traffic path" ;
    :hasSeverityScore :sev2 .

:risk3 a :LaneIntrusionRisk ;
    :description "Vehicle parked in non-standard position near road hazard" ;
    :hasSeverityScore :sev3 .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.85"^^xsd:float .

:sev3 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .
```

