@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Nighttime Urban Road with Potential Occlusion Risk" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasObstacle :obstacle1 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1 ;
    :hasRisk :risk2 .

:obstacle1 a :RoadObject ;
    :description "Large truck partially obscured by road curvature and lighting conditions" .

:weather1 a :NightCondition ;
