Scene Description in RDF Triples (Turtle Format)
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "FoggyUrbanRearEnd" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :occursInScene :scene1 ;
    :hasActor :vehicle1 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1 .

:vehicle1 a :Vehicle ;
    :description "Lead vehicle in close proximity" .

:weather1 a :FoggyCondition .

:risk1 a :RearEndCollisionRisk ;
    :description "High risk of rear-end collision due to low visibility in fog" ;
    :hasSeverityScore :sev1 ;
    :confidenceScore "0.95"^^xsd:float .

:sev1 a :SeverityScore ;
    :severityValue "0.80"^^xsd:float .

