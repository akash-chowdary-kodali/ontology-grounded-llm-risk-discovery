### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "NighttimeWetRoadWithOcclusion" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasWeatherCondition :weather1 ;
    :hasObstacle :obstacle1 ;
    :hasEvidence :evidence1 ;
    :hasRisk :risk1, :risk2, :risk3 .

:weather1 a :NightCondition ;
    :description "Low visibility due to nighttime and wet road conditions" .

:obstacle1 a :RoadObject ;
    :description "Foggy conditions reducing visibility beyond 50 meters" .

:evidence1 a :RollingBallIndicator ;
    :description "Water droplets on windshield indicating recent rain" ;
    :indicatesPotentialRisk :risk1 .

:risk1 a :OcclusionRisk ;
    :description "Reduced visibility due to fog and nighttime conditions" ;
    :hasSeverityScore :sev1 .

:sev1 a :SeverityScore ;
    :severityValue "0.85"^^xsd:float .

:risk2 a :RoadConditionRisk ;
    :description "Wet road surface increasing skid risk" ;
    :hasSeverityScore :sev2 .

:sev2 a :SeverityScore ;
    :severityValue "0.70"^^xsd:float .

:risk3 a :DistractionRisk ;
    :description "Headlight glare from oncoming vehicle" ;
    :hasSeverityScore :sev3 .

:sev3 a :SeverityScore ;
    :severityValue "0.60"^^xsd:float .
```

