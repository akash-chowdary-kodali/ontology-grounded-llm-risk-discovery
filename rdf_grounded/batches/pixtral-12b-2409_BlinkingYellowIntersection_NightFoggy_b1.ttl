    :indicatesPotentialRisk :risk1 .

:weather1 a :NightCondition .

:risk1 a :RearEndCollisionRisk ;
    :description "Potential rear-end collision risk due to vehicle door obstructing traffic" ;
    :hasSeverityScore :sev1 .

:risk2 a :OcclusionRisk ;
    :description "Driver-side door obstructing view of surrounding traffic" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:trafficLight1 a :TrafficLight ;
