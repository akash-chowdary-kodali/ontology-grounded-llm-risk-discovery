@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Nighttime Urban Intersection with Vehicle Door Open" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasActor :vehicle1 ;
    :hasEvidence :evidence1 ;
    :hasRisk :risk1, :risk2 ;
    :hasWeatherCondition :weather1 ;
    :occursInScene :scene1 .

:vehicle1 a :Vehicle ;
