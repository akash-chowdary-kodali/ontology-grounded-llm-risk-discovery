Scene Description in RDF Triples (Turtle Format)
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "RollingBallNightRain" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :occursInScene :scene1 ;
    :hasWeatherCondition :weather1 ;
    :hasEvidence :indicator1 ;
    :hasRisk :risk1 .

:weather1 a :RainyCondition .

:indicator1 a :RollingBallIndicator ;
    :description "A ball rolling across the street at night in rainy conditions" ;
    :indicatesPotentialRisk :risk1 .

:risk1 a :PedestrianCollisionRisk ;
    :description "Potential child following ball into the vehicle path" ;
    :hasSeverityScore :sev1 .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .

