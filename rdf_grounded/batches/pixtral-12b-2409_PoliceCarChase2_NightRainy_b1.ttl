### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Nighttime Urban Tunnel with Wet Road" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :description "Wet road conditions in a tunnel with poor visibility due to lighting and reflections" ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1, :risk2 ;
    :hasObstacle :obstacle1 .

:weather1 a :NightCondition ;
    :description "Nighttime with artificial lighting in tunnel" .

:risk1 a :RoadConditionRisk ;
    :description "High risk of hydroplaning or reduced traction due to wet road surface" ;
    :hasSeverityScore :sev1 ;
    :confidenceScore "0.92"^^xsd:float .

:sev1 a :SeverityScore ;
    :severityValue "0.88"^^xsd:float .

:risk2 a :OcclusionRisk ;
    :description "Reduced visibility due to water reflections and tunnel lighting" ;
    :hasSeverityScore :sev2 ;
    :confidenceScore "0.85"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:obstacle1 a :RoadObject ;
    :description "Wet road surface with standing water in tunnel" .

:vehicle1 a :Vehicle ;
    :description "Black vehicle ahead in tunnel" .

:vehicle2 a :Vehicle ;
    :description "White vehicle in adjacent lane" .
```

