### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Nighttime Roadwork with Pedestrian Activity" ;
    :hasCornerCaseType :cc1 .

:cc1 a :BehaviorAnomaly ;
    :hasActor :actor1, :actor2 ;
    :hasObstacle :obstacle1 ;
    :hasEvidence :evidence1 ;
    :hasRisk :risk1, :risk2, :risk3 ;
    :hasWeatherCondition :weather1 .

:actor1 a :Pedestrian ;
    :description "Worker kneeling near roadwork area" .

:actor2 a :Pedestrian ;
    :description "Worker crossing road unexpectedly" .

:obstacle1 a :RoadObject ;
    :description "Roadwork barriers and orange traffic cones" .

:evidence1 a :RollingBallIndicator ;
    :description "Rolling ball test for roadwork area" ;
    :indicatesPotentialRisk :risk3 .

:weather1 a :NightCondition ;
    :description "Low-light nighttime environment" .

:risk1 a :PedestrianCollisionRisk ;
    :description "Pedestrian crossing into vehicle path" ;
    :hasSeverityScore :sev1 .

:risk2 a :OcclusionRisk ;
    :description "Roadwork barriers obstructing visibility" ;
    :hasSeverityScore :sev2 .

:risk3 a :RoadConditionRisk ;
    :description "Unstable road surface due to roadwork" ;
    :hasSeverityScore :sev3 .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:sev3 a :SeverityScore ;
    :severityValue "0.80"^^xsd:float .
```

