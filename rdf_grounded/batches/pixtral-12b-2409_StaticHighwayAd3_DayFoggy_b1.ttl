@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "FoggyUrbanIntersection" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasWeatherCondition :foggyCondition ;
    :hasObstacle :roadObstacle ;
    :hasRisk :occlusionRisk, :weatherRisk ;
    :description "Severe fog reduces visibility in urban intersection" .

:foggyCondition a :FoggyCondition ;
    :description "Dense fog obscuring visibility beyond 50 meters" .

:roadObstacle a :RoadObject ;
    :description "Fog-induced reduced visibility of road markings and signs" .

:occlusionRisk a :OcclusionRisk ;
    :description "Fog obscures traffic signs and potential pedestrians" ;
    :hasSeverityScore :sev1 .

:weatherRisk a :WeatherRisk ;
    :description "Fog reduces braking distance and increases collision likelihood" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
    :severityValue "0.92"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.88"^^xsd:float .

:billboard1 a :Billboard ;
    :description "Advertisement billboard partially visible in fog" .

:trafficSign1 a :TrafficSign ;
    :description "No entry sign partially obscured by fog" .
```

