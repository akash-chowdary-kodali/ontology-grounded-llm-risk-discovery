```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "FoggyRoadWithObstructedBillboard" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasWeatherCondition :foggyCondition ;
    :hasObstacle :billboardObstacle ;
    :hasRisk :occlusionRisk ;
    :hasRisk :roadConditionRisk .

:foggyCondition a :FoggyCondition ;
    :description "Heavy fog reducing visibility on urban road" .

:billboardObstacle a :Billboard ;
    :description "Large red billboard partially obstructing road view" .

:occlusionRisk a :OcclusionRisk ;
    :description "Billboard obstructs visibility of road ahead in fog" ;
    :hasSeverityScore :sev1 .

:roadConditionRisk a :RoadConditionRisk ;
    :description "Foggy conditions reduce road visibility and increase collision risk" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.85"^^xsd:float .
```

