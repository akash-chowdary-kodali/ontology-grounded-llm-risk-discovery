### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "HeavyRainIntersectionApproach" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasWeatherCondition :weather1 ;
    :hasObstacle :obstacle1 ;
    :hasRisk :risk1, :risk2, :risk3 ;
    :hasEvidence :evidence1 .

:weather1 a :RainyCondition ;
    :description "Heavy rain reducing visibility and traction" .

:obstacle1 a :RoadObject ;
    :description "Wet road surface with reduced friction" .

:evidence1 a :RollingBallIndicator ;
    :description "Water splashing indicates poor traction" ;
    :indicatesPotentialRisk :risk3 .

:risk1 a :CollisionRisk ;
    :description "High risk of rear-end collision due to reduced visibility" ;
    :hasSeverityScore :sev1 .

:risk2 a :OcclusionRisk ;
    :description "Heavy rain occludes visibility of other vehicles and pedestrians" ;
    :hasSeverityScore :sev2 .

:risk3 a :RoadConditionRisk ;
    :description "Slippery road conditions increase braking distance" ;
    :hasSeverityScore :sev3 .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.85"^^xsd:float .

:sev3 a :SeverityScore ;
    :severityValue "0.80"^^xsd:float .

:trafficLight1 a :TrafficLight ;
    :description "Red traffic light partially visible through rain" .

:vehicle1 a :Vehicle ;
    :description "Red vehicle in foreground approaching intersection" .

:vehicle2 a :Vehicle ;
    :description "Yellow vehicle in distance, partially obscured by rain" .
```

