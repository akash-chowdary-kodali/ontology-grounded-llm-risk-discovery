```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Night scene with pedestrians and obstacles" ;
    :hasCornerCaseType :cc1 .

:cc1 a :BehaviorAnomaly ;
    :hasActor :actor1, :actor2 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1, :risk2 .

:actor1 a :Pedestrian .
:actor2 a :Pedestrian .
:weather1 a :RainyCondition .

:risk1 a :PedestrianCollisionRisk ;
    :description "Pedestrian walking unexpectedly in the road" ;
    :hasSeverityScore :sev1 .

:risk2 a :RoadConditionRisk ;
    :description "Wet road conditions due to rain" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.60"^^xsd:float .
```

