### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Nighttime Road Construction with Pedestrian Near Open Vehicle Door" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasActor :actor1 ;
    :hasObstacle :obstacle1 ;
    :hasEvidence :evidence1 ;
    :hasRisk :risk1, :risk2 ;
    :hasWeatherCondition :weather1 .

:actor1 a :Pedestrian ;
    :description "Pedestrian standing near open vehicle door" .

:obstacle1 a :RoadObject ;
    :description "Road construction barrels and equipment on roadside" .

:evidence1 a :OpenDoorIndicator ;
    :description "Vehicle door open with pedestrian standing nearby" ;
    :indicatesPotentialRisk :risk1 .

:weather1 a :NightCondition ;
    :description "Nighttime with low visibility" .

:risk1 a :PedestrianCollisionRisk ;
    :description "Pedestrian near open vehicle door in path of traffic" ;
    :hasSeverityScore :sev1 .

:risk2 a :OcclusionRisk ;
    :description "Construction barrels partially obstructing view of pedestrian" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
    :severityValue "0.92"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.78"^^xsd:float .
```

