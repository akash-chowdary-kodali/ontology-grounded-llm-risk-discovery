### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Nighttime Road with Wet Surface and Sandbags" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasObstacle :obstacle1 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1, :risk2, :risk3 ;
    :hasEvidence :evidence1 .

:obstacle1 a :RoadObject ;
    :description "Sandbags blocking part of the road" .

:weather1 a :NightCondition ;
    :description "Nighttime with low visibility" .

:evidence1 a :FallingObjectIndicator ;
    :description "Wet road surface indicating potential hydroplaning risk" ;
    :indicatesPotentialRisk :risk2 .

:risk1 a :OcclusionRisk ;
    :description "Sandbags partially obstructing view of the road ahead" ;
    :hasSeverityScore :sev1 .

:risk2 a :RoadConditionRisk ;
    :description "Wet road surface increasing risk of hydroplaning" ;
    :hasSeverityScore :sev2 .

:risk3 a :DistractionRisk ;
    :description "Bright streetlights and reflections may distract the driver" ;
    :hasSeverityScore :sev3 .

:sev1 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.80"^^xsd:float .

:sev3 a :SeverityScore ;
    :severityValue "0.60"^^xsd:float .
```

