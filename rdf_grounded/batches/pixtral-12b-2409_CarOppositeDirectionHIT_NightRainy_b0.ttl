### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "NighttimeWetRoadWithPedestrianOcclusion" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasActor :actor1 ;
    :hasObstacle :obstacle1 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1, :risk2 ;
    :hasEvidence :evidence1 .

:actor1 a :Pedestrian ;
    :description "Blurred pedestrian walking on sidewalk" .

:obstacle1 a :RoadObject ;
    :description "Large puddle covering road markings" .

:weather1 a :NightCondition ;
    :description "Dark environment with artificial lighting" .

:evidence1 a :OcclusionRisk ;
    :description "Pedestrian partially obscured by vehicle headlights and reflections" ;
    :indicatesPotentialRisk :risk1 .

:risk1 a :OcclusionRisk ;
    :description "High occlusion of pedestrian due to wet road reflections and night lighting" ;
    :hasSeverityScore :sev1 .

:risk2 a :RoadConditionRisk ;
    :description "Slippery road conditions due to large puddle" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .
```

