### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Nighttime Urban Intersection with Wet Road" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasObstacle :roadObject1 ;
    :hasWeatherCondition :nightCondition1 ;
    :hasRisk :risk1, :risk2, :risk3 ;
    :description "Wet road surface with low visibility at night, potential for reduced traction and obscured traffic signals." .

:roadObject1 a :RoadObject ;
    :description "Wet road surface with reflective sheen indicating recent rain." .

:nightCondition1 a :NightCondition ;
    :description "Low-light urban environment with artificial lighting." .

:risk1 a :RoadConditionRisk ;
    :description "Reduced traction due to wet road surface, increasing skid risk." ;
    :hasSeverityScore :sev1 .

:risk2 a :OcclusionRisk ;
    :description "Reflective road surface obscures visibility of traffic signals and distant objects." ;
    :hasSeverityScore :sev2 .

:risk3 a :WeatherRisk ;
    :description "Nighttime conditions reduce visibility and reaction time." ;
    :hasSeverityScore :sev3 .

:sev1 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.65"^^xsd:float .

:sev3 a :SeverityScore ;
    :severityValue "0.80"^^xsd:float .

:trafficLight1 a :TrafficLight ;
    :description "Green traffic signal visible in the scene." .

:vehicle1 a :Vehicle ;
    :description "Vehicle in the distance, partially obscured by wet road reflections." .
```

