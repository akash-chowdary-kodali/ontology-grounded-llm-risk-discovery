### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "NighttimePedestrianCrossing" ;
    :hasCornerCaseType :cc1 .

:cc1 a :BehaviorAnomaly ;
    :hasActor :actor1 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1, :risk2 ;
    :description "Pedestrians crossing road at night despite red traffic light" .

:actor1 a :Pedestrian ;
    :description "Two pedestrians running across intersection" .

:weather1 a :NightCondition ;
    :description "Nighttime with low visibility" .

:risk1 a :PedestrianCollisionRisk ;
    :description "High risk of collision with pedestrians crossing against traffic light" ;
    :hasSeverityScore :sev1 .

:risk2 a :DistractionRisk ;
    :description "Potential distraction due to unexpected pedestrian movement at night" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
    :severityValue "0.95"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:trafficLight1 a :TrafficLight ;
    :description "Red traffic light at intersection" .

:roadMarking1 a :RoadObject ;
    :description "Arrow marking indicating straight/ahead direction" .
```

