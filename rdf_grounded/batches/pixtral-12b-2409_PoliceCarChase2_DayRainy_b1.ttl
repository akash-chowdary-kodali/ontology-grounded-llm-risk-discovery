:scene1 a :Scene ;
    :scenarioName "HeavyRainWithLaneIntrusion" ;
    :hasCornerCaseType :cc1 .

:cc1 a :BehaviorAnomaly ;
    :hasActor :vehicle1, :vehicle2 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1, :risk2, :risk3 ;
    :hasEvidence :evidence1 .

:vehicle1 a :Vehicle ;
