:weather1 a :RainyCondition ;
    :description "Heavy rain reducing visibility" .

:risk1 a :CollisionRisk ;
    :description "Potential rear-end collision due to reduced braking distance in rain" ;
    :hasSeverityScore :sev1 .
:risk2 a :LaneIntrusionRisk ;
    :description "White vehicle drifting into left lane due to slippery road conditions" ;
    :hasSeverityScore :sev2 .
:risk3 a :RoadConditionRisk ;
    :description "Slippery road surface increasing skid risk" ;
    :hasSeverityScore :sev3 .

:evidence1 a :RollingBallIndicator ;
    :description "Water droplets and spray indicating heavy rain and poor traction" ;
    :indicatesPotentialRisk :risk1, :risk2, :risk3 .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .
:sev2 a :SeverityScore ;
    :severityValue "0.85"^^xsd:float .
:sev3 a :SeverityScore ;
    :severityValue "0.80"^^xsd:float .
