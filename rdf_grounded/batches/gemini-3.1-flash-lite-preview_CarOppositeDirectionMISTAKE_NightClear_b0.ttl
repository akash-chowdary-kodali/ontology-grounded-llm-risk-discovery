Scene Description in RDF Triples (Turtle Format)
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "NighttimeIntersectionCrossTraffic" ;
    :hasCornerCaseType :cc1 .

:cc1 a :BehaviorAnomaly ;
    :hasActor :vehicle1 ;
    :hasWeatherCondition :night1 ;
    :hasRisk :risk1 .

:vehicle1 a :Vehicle ;
    :description "Black sedan performing a rapid lateral traversal across the ego-vehicle path" .

:night1 a :NightCondition .

:risk1 a :CollisionRisk ;
    :description "Lateral collision risk due to vehicle crossing intersection path at night" ;
    :hasSeverityScore :sev1 .

:sev1 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

