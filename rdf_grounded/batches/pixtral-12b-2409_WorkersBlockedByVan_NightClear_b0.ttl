### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "NighttimePedestrianObstructionScenario" ;
    :hasCornerCaseType :cc1 .

:cc1 a :BehaviorAnomaly ;
    :hasActor :actor1, :actor2 ;
    :hasObstacle :obstacle1 ;
    :hasRisk :risk1, :risk2 ;
    :hasWeatherCondition :weather1 .

:actor1 a :Pedestrian ;
    :description "Pedestrian pushing large cylindrical object across road" .

:actor2 a :Pedestrian ;
    :description "Pedestrian running/jogging across road" .

:obstacle1 a :RoadObject ;
    :description "Large cylindrical obstacle blocking part of the road" .

:weather1 a :NightCondition ;
    :description "Nighttime with artificial lighting" .

:risk1 a :PedestrianCollisionRisk ;
    :description "Pedestrian with large object obstructing vehicle path" ;
    :hasSeverityScore :sev1 .

:risk2 a :LaneIntrusionRisk ;
    :description "Pedestrian running across road into vehicle lane" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
    :severityValue "0.92"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.88"^^xsd:float .
```

