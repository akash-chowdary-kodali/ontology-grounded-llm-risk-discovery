@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Nighttime Urban Parking Lot with Wet Road" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasObstacle :roadObject1 ;
    :hasWeatherCondition :nightCondition ;
    :hasRisk :risk1, :risk2 ;
    :hasEvidence :evidence1 .

:roadObject1 a :RoadObject ;
    :description "Wet road surface with reflective sheen indicating recent rain" .

:nightCondition a :NightCondition ;
    :description "Low-light urban environment with artificial lighting" .

:evidence1 a :RollingBallIndicator ;
    :description "Reflective sheen on wet road resembling rolling ball indicator" ;
    :indicatesPotentialRisk :risk2 .

:risk1 a :OcclusionRisk ;
    :description "Limited visibility due to nighttime and artificial lighting shadows" ;
    :hasSeverityScore :sev1 .

:risk2 a :RoadConditionRisk ;
    :description "Slippery road surface due to wet conditions" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.80"^^xsd:float .
```

