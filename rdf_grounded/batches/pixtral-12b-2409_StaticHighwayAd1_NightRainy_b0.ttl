@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "NighttimeIntersectionWithFogAndWetRoad" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasWeatherCondition :weather1 ;
    :hasObstacle :roadObject1 ;
    :hasRisk :risk1, :risk2, :risk3 ;
    :hasEvidence :evidence1, :evidence2 .

:weather1 a :FoggyCondition ;
    :description "Heavy fog reducing visibility" .

:roadObject1 a :RoadObject ;
    :description "Wet road surface with reflective glare" .

:evidence1 a :RollingBallIndicator ;
