    :indicatesPotentialRisk :risk2 .

:evidence2 a :OpenDoorIndicator ;
    :description "Potential for obscured visibility due to fog" ;
    :indicatesPotentialRisk :risk3 .

:risk1 a :OcclusionRisk ;
    :description "Heavy fog obscuring traffic signs and signals" ;
    :hasSeverityScore :sev1 ;
    :confidenceScore "0.92"^^xsd:float .

:risk2 a :RoadConditionRisk ;
    :description "Wet road with glare increasing braking distance" ;
    :hasSeverityScore :sev2 ;
    :confidenceScore "0.88"^^xsd:float .

:risk3 a :DistractionRisk ;
    :description "Fog-induced glare may distract driver" ;
    :hasSeverityScore :sev3 ;
    :confidenceScore "0.75"^^xsd:float .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.85"^^xsd:float .

:sev3 a :SeverityScore ;
    :severityValue "0.70"^^xsd:float .
