```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Urban night scene with wet roads" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasActor :actor1 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1 ;
    :hasObstacle :obstacle1 .

:actor1 a :Vehicle .

:weather1 a :RainyCondition .

:obstacle1 a :RoadObject ;
    :description "Wet road with potential for hydroplaning" .

:risk1 a :RoadConditionRisk ;
    :description "Wet road conditions increase the likelihood of loss of traction" ;
    :hasSeverityScore :sev1 .

:sev1 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .
