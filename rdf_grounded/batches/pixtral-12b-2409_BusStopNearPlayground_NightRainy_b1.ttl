### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "NighttimePedestrianCrossingInRain" ;
    :hasCornerCaseType :cc1 .

:cc1 a :BehaviorAnomaly ;
    :hasActor :actor1 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1, :risk2 ;
    :hasEvidence :evidence1 .

:actor1 a :Pedestrian ;
    :description "Two pedestrians crossing road at night in rain" .

:weather1 a :RainyCondition ;
    :description "Heavy rain with poor visibility" .

:risk1 a :PedestrianCollisionRisk ;
    :description "Pedestrians crossing road unexpectedly in low visibility" ;
    :hasSeverityScore :sev1 .

:risk2 a :OcclusionRisk ;
    :description "Rain and darkness reduce visibility of pedestrians" ;
    :hasSeverityScore :sev2 .

:evidence1 a :FallingObjectIndicator ;
    :description "Raindrops on windshield indicating poor visibility" ;
    :indicatesPotentialRisk :risk2 .

:sev1 a :SeverityScore ;
    :severityValue "0.95"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.88"^^xsd:float .
```

