### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "NighttimeIntersectionWithTrafficSigns" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasObstacle :obstacle1 ;
    :hasRisk :risk1, :risk2 ;
    :hasWeatherCondition :weather1 .

:obstacle1 a :RoadObject ;
    :description "Traffic signs and billboards at nighttime intersection" .

:weather1 a :NightCondition ;
    :description "Low-light conditions with artificial lighting" .

:risk1 a :DistractionRisk ;
    :description "Bright billboards may distract driver attention" ;
    :hasSeverityScore :sev1 .

:risk2 a :OcclusionRisk ;
    :description "Nighttime conditions may obscure visibility of pedestrians/cyclists" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
    :severityValue "0.65"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.70"^^xsd:float .

:trafficSign1 a :TrafficSign ;
    :description "No entry sign on right side of road" .

:trafficSign2 a :TrafficSign ;
    :description "Overhead traffic control sign (multiple lanes)" .

:billboard1 a :Billboard ;
    :description "Large illuminated billboard on left side" .

:billboard2 a :Billboard ;
    :description "Large illuminated billboard on right side" .
```

