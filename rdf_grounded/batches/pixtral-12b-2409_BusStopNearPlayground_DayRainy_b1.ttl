@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "RainyDayPedestrianCrossing" ;
    :hasCornerCaseType :cc1 .

:cc1 a :BehaviorAnomaly ;
    :hasActor :actor1 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1, :risk2 ;
    :hasEvidence :evidence1 .

:actor1 a :Pedestrian ;
    :description "Two pedestrians crossing road in rainy conditions" .

:weather1 a :RainyCondition ;
