```
Scene Description in RDF Triples (Turtle Format)
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "PedestrianCrossingWithOcclusion" ;
    :hasCornerCaseType :cc1 .

:cc1 a :BehaviorAnomaly ;
    :hasActor :actor1 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1, :risk2, :risk3 .

:actor1 a :Pedestrian ;
    :description "Pedestrian walking across the road from behind a vehicle" .

:weather1 a :ClearCondition .

:risk1 a :PedestrianCollisionRisk ;
    :description "Pedestrian crossing road unexpectedly from behind vehicle" ;
    :hasSeverityScore :sev1 .

:risk2 a :OcclusionRisk ;
    :description "Vehicle obstructs view of pedestrian from driver's perspective" ;
    :hasSeverityScore :sev2 .

:risk3 a :LaneIntrusionRisk ;
    :description "Pedestrian intruding into vehicle path" ;
    :hasSeverityScore :sev3 .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.85"^^xsd:float .

:sev3 a :SeverityScore ;
    :severityValue "0.80"^^xsd:float .
```

