Scene Description in RDF Triples (Turtle Format)
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "OpposingVehicleLaneIntrusion" ;
    :hasCornerCaseType :cc1 .

:cc1 a :BehaviorAnomaly ;
    :hasActor :actor1 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1 .

:actor1 a :Vehicle ;
    :description "Black sedan crossing into the ego-vehicle lane" .

:weather1 a :NightCondition .

:risk1 a :LaneIntrusionRisk ;
    :description "Opposing vehicle drifting into ego-vehicle's lane, creating potential for head-on collision" ;
    :hasSeverityScore :sev1 ;
    :confidenceScore "0.95"^^xsd:float .

:sev1 a :SeverityScore ;
    :severityValue "0.92"^^xsd:float .

