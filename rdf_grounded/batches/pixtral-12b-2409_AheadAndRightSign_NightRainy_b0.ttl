@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Nighttime Wet Road with Occlusion Risk" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1, :risk2 ;
    :hasObstacle :obstacle1 ;
    :hasEvidence :evidence1 .

:weather1 a :NightCondition ;
    :description "Low visibility due to nighttime" .

:risk1 a :OcclusionRisk ;
    :description "Occlusion caused by puddle reflections and nighttime glare" ;
    :hasSeverityScore :sev1 .

:risk2 a :RoadConditionRisk ;
    :description "Wet road surface increasing skid risk" ;
    :hasSeverityScore :sev2 .

:obstacle1 a :RoadObject ;
    :description "Large puddle causing road surface distortion" .

:evidence1 a :RollingBallIndicator ;
    :description "Road surface appears wet with reflective puddles" ;
    :indicatesPotentialRisk :risk1, :risk2 .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .
```

