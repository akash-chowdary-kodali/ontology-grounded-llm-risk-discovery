### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "HeavyFogIntersectionScenario" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasWeatherCondition :foggyCondition ;
    :hasRisk :occlusionRisk ;
    :hasRisk :rearEndCollisionRisk ;
    :hasEvidence :evidence1 .

:foggyCondition a :FoggyCondition ;
    :description "Heavy fog reducing visibility to less than 10 meters" .

:evidence1 a :FallingObjectIndicator ;
    :description "Fog particles visible in headlight beams, indicating poor visibility" ;
    :indicatesPotentialRisk :occlusionRisk .

:occlusionRisk a :OcclusionRisk ;
    :description "Heavy fog obscures visibility of other vehicles and pedestrians" ;
    :hasSeverityScore :sev1 .

:sev1 a :SeverityScore ;
    :severityValue "0.95"^^xsd:float .

:rearEndCollisionRisk a :RearEndCollisionRisk ;
    :description "Risk of rear-end collision due to poor visibility of stopped vehicle ahead" ;
    :hasSeverityScore :sev2 .

:sev2 a :SeverityScore ;
    :severityValue "0.88"^^xsd:float .

:vehicle1 a :Vehicle ;
    :description "Stopped vehicle in intersection" .

:vehicle2 a :Vehicle ;
    :description "Ego vehicle approaching intersection" .
```

