@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "HeavyRainUrbanIntersection" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1, :risk2 ;
    :hasEvidence :evidence1 .

:weather1 a :RainyCondition .

:evidence1 a :FallingObjectIndicator ;
    :description "Heavy rain reducing visibility and creating wet road conditions" ;
    :indicatesPotentialRisk :risk1, :risk2 .

:risk1 a :WeatherRisk ;
    :description "Reduced visibility due to heavy rain" ;
    :hasSeverityScore :sev1 .

:risk2 a :RoadConditionRisk ;
    :description "Slippery road surface due to rain" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
    :severityValue "0.9"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.85"^^xsd:float .
```

