:actor2 a :Pedestrian ;
    :description "Pedestrian running across road" .

:obstacle1 a :RoadObject ;
    :description "Large cylindrical object on road" .

:obstacle2 a :RoadObject ;
    :description "Orange traffic cones on road" .

:weather1 a :NightCondition ;
    :description "Low-light nighttime environment" .

:risk1 a :PedestrianCollisionRisk ;
    :description "Running pedestrian crossing path of vehicle" ;
    :hasSeverityScore :sev1 .

:risk2 a :OcclusionRisk ;
    :description "Large road object obstructing visibility of pedestrian" ;
    :hasSeverityScore :sev2 .

:risk3 a :DistractionRisk ;
    :description "Unusual pedestrian behavior (kneeling) may distract driver" ;
    :hasSeverityScore :sev3 .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.85"^^xsd:float .

:sev3 a :SeverityScore ;
    :severityValue "0.70"^^xsd:float .
