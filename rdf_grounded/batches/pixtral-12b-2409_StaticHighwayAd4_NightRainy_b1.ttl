:risk1 a :RoadConditionRisk ;
    :description "High risk of hydroplaning or reduced traction due to wet road" ;
    :hasSeverityScore :sev1 .

:risk2 a :OcclusionRisk ;
    :description "Reduced visibility due to nighttime and rain, increasing risk of missing obstacles" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
    :severityValue "0.9"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.8"^^xsd:float .

:billboard1 a :Billboard ;
    :description "Advertisement billboard on the left side of the road" .

:trafficSign1 a :TrafficSign ;
    :description "Speed limit sign (90 km/h) on the right side of the road" .
```

