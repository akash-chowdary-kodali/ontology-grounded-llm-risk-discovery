@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "NighttimeFoggyIntersectionWithRedLight" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasWeatherCondition :weather1 ;
    :hasObstacle :obstacle1 ;
    :hasRisk :risk1, :risk2, :risk3 ;
    :hasEvidence :evidence1 .

:weather1 a :FoggyCondition ;
    :description "Heavy fog reducing visibility at night" .

:obstacle1 a :RoadObject ;
    :description "Fog obscuring road markings and traffic signs" .

:evidence1 a :FallingObjectIndicator ;
    :description "Fog particles acting as visual noise, obscuring scene details" ;
    :indicatesPotentialRisk :risk1 .

:risk1 a :OcclusionRisk ;
    :description "Reduced visibility due to fog, increasing collision risk" ;
    :hasSeverityScore :sev1 .

:risk2 a :WeatherRisk ;
    :description "Foggy conditions impairing sensor and driver perception" ;
    :hasSeverityScore :sev2 .

:risk3 a :DistractionRisk ;
    :description "Headlights reflecting off fog, creating glare and potential distraction" ;
    :hasSeverityScore :sev3 .

:sev1 a :SeverityScore ;
    :severityValue "0.92"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.88"^^xsd:float .

:sev3 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:trafficLight1 a :TrafficLight ;
    :description "Red traffic light at intersection" .

:billboard1 a :Billboard ;
    :description "Advertisement billboard partially obscured by fog" .

:trafficSign1 a :TrafficSign ;
    :description "No entry sign partially visible on right side" .
