@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "ConstructionEquipmentInRoadway" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasObstacle :obstacle1 ;
    :hasEvidence :evidence1 ;
    :hasRisk :risk1 ;
    :hasRisk :risk2 ;
    :hasWeatherCondition :weather1 .

:obstacle1 a :RoadObject ;
    :description "Construction excavator bucket protruding into roadway" .

