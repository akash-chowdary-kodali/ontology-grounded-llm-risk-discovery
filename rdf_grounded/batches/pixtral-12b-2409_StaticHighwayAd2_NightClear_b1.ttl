### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "NighttimeRoadWithBillboardsAndSpeedLimit" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :description "Nighttime road with potential distraction from billboards and speed limit sign" ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1 ;
    :hasRisk :risk2 ;
    :hasObstacle :obstacle1 .

:weather1 a :NightCondition .

:risk1 a :DistractionRisk ;
    :description "Bright billboards may distract driver at night" ;
    :hasSeverityScore :sev1 .

:risk2 a :RoadConditionRisk ;
    :description "Wet road surface may reduce traction" ;
    :hasSeverityScore :sev2 .

:obstacle1 a :RoadObject ;
    :description "Speed limit sign (90 km/h) and billboards" .

:billboard1 a :Billboard ;
    :description "Restaurant billboard with 'Are You Hungry?' text" .

:billboard2 a :Billboard ;
    :description "Restaurant billboard with 'Dr. Carle' text" .

:trafficSign1 a :TrafficSign ;
    :description "Speed limit sign (90 km/h)" .

:sev1 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.60"^^xsd:float .
```

