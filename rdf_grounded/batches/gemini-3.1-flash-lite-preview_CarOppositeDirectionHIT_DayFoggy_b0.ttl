Scene Description in RDF Triples (Turtle Format)
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "FoggyIntersectionHeadOn" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasActor :vehicle1 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1 .

:vehicle1 a :Vehicle ;
    :description "Vehicle approaching in the wrong lane in dense fog" .

:weather1 a :FoggyCondition .

:risk1 a :CollisionRisk ;
    :description "Head-on collision risk due to oncoming vehicle in the ego-vehicle's lane under low visibility" ;
    :hasSeverityScore :sev1 ;
    :confidenceScore "0.95"^^xsd:float .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .

