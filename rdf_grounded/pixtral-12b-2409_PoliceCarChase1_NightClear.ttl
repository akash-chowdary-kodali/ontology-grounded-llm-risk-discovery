@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "UndergroundParkingGarageTraffic" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasActor :vehicle1 ;
    :hasObstacle :obstacle1 ;
    :hasRisk :risk1, :risk2 ;
    :hasWeatherCondition :weather1 ;
    :hasEvidence :evidence1 .

:vehicle1 a :Vehicle ;
    :description "Following vehicle in underground parking garage" .

