### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "HeavyRainWithRoadWorkers" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasActor :actor1, :actor2 ;
    :hasObstacle :obstacle1 ;
    :hasEvidence :evidence1, :evidence2 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1, :risk2, :risk3 .

:actor1 a :Pedestrian ;
    :description "Road worker with heavy equipment on left side" .
:actor2 a :Pedestrian ;
    :description "Pedestrian walking near roadwork zone" .

:obstacle1 a :RoadObject ;
    :description "Large concrete barrier blocking part of road" .

:evidence1 a :FallingObjectIndicator ;
    :description "Heavy equipment being moved by road worker" ;
    :indicatesPotentialRisk :risk1 .
:evidence2 a :RollingBallIndicator ;
    :description "Orange traffic cones near roadwork zone" ;
    :indicatesPotentialRisk :risk2 .

:weather1 a :RainyCondition ;
    :description "Heavy rain reducing visibility" .

:risk1 a :CollisionRisk ;
    :description "Potential collision with road worker handling heavy equipment" ;
    :hasSeverityScore :sev1 .
:risk2 a :OcclusionRisk ;
    :description "Traffic cones and equipment obstructing clear path" ;
    :hasSeverityScore :sev2 .
:risk3 a :RoadConditionRisk ;
    :description "Flooded road conditions reducing traction" ;
    :hasSeverityScore :sev3 .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .
:sev2 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .
:sev3 a :SeverityScore ;
    :severityValue "0.80"^^xsd:float .
```

