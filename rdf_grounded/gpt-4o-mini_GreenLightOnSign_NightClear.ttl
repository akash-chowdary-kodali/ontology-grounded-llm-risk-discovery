```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "NightSceneWithTrafficLightAndBillboard" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1 ;
    :hasRisk :risk2 .

:weather1 a :NightCondition .

:risk1 a :DistractionRisk ;
    :description "Potential distraction from illuminated billboard" ;
    :hasSeverityScore :sev1 .

:sev1 a :SeverityScore ;
    :severityValue "0.40"^^xsd:float .

:risk2 a :LaneIntrusionRisk ;
    :description "Risk of vehicle lane intrusion due to poor visibility at night" ;
    :hasSeverityScore :sev2 .

:sev2 a :SeverityScore ;
    :severityValue "0.60"^^xsd:float .

:billboard1 a :Billboard ;
    :description "Illuminated advertisement billboard" .

:trafficLight1 a :TrafficLight ;
    :description "Traffic light at intersection" .
```

