### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Nighttime Rolling Soccer Ball on Road" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasObstacle :obstacle1 ;
    :hasEvidence :evidence1 ;
    :hasRisk :risk1 ;
    :hasWeatherCondition :weather1 .

:obstacle1 a :RoadObject ;
    :description "Soccer ball rolling on road" .

:evidence1 a :RollingBallIndicator ;
    :description "Soccer ball detected in vehicle path" ;
    :indicatesPotentialRisk :risk1 .

:risk1 a :CollisionRisk ;
    :description "Potential collision with rolling soccer ball" ;
    :hasSeverityScore :sev1 .

:sev1 a :SeverityScore ;
    :severityValue "0.9"^^xsd:float .

:weather1 a :NightCondition ;
    :description "Nighttime with low visibility" .
```

