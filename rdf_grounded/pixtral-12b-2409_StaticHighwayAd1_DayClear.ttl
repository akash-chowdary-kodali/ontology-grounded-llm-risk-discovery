    :hasSeverityScore :sev1 .

:risk2 a :OcclusionRisk ;
    :description "Potential occlusion of smaller actors or objects by large billboard" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
    :severityValue "0.35"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.25"^^xsd:float .
