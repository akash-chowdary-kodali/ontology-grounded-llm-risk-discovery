@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:parkingLotScene a :Scene ;
    :scenarioName "Nighttime Parking Lot with Vehicle Door Hazard" ;
    :hasCornerCaseType :doorHazardCase .

