    :hasSeverityScore :sev1 .

:risk2 a :WeatherRisk ;
    :description "Foggy conditions reducing overall visibility and increasing collision risk" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.85"^^xsd:float .

:trafficSign1 a :TrafficSign ;
    :description "No right turn sign partially obscured by fog" .

:billboard1 a :Billboard ;
    :description "Billboard partially visible in fog" .
```

