:actor2 a :Pedestrian ;
    :description "Pedestrian running/jogging across road" .

:obstacle1 a :RoadObject ;
    :description "Large cylindrical obstacle blocking part of the road" .

:weather1 a :NightCondition ;
    :description "Nighttime with artificial lighting" .

:risk1 a :PedestrianCollisionRisk ;
    :description "Pedestrian with large object obstructing vehicle path" ;
    :hasSeverityScore :sev1 .

:risk2 a :LaneIntrusionRisk ;
    :description "Pedestrian running across road into vehicle lane" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
