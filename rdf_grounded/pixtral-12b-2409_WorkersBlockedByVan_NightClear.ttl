@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "NighttimePedestrianObstructionScenario" ;
    :hasCornerCaseType :cc1 .

:cc1 a :BehaviorAnomaly ;
    :hasActor :actor1, :actor2 ;
    :hasObstacle :obstacle1 ;
    :hasRisk :risk1, :risk2 ;
    :hasWeatherCondition :weather1 .

:actor1 a :Pedestrian ;
