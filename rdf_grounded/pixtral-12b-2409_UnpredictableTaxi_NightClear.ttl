:risk2 a :LaneIntrusionRisk ;
    :description "Potential lane intrusion risk due to vehicle's position near lane markings" ;
    :hasSeverityScore :sev2 ;
    :confidenceScore "0.75"^^xsd:float .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .

