### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "TunnelLaneIntrusionWithFog" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasActor :vehicle1 ;
    :hasObstacle :fogObstacle ;
    :hasEvidence :fogEvidence ;
    :hasRisk :laneIntrusionRisk ;
    :hasRisk :occlusionRisk ;
    :hasWeatherCondition :foggyCondition .

:vehicle1 a :Vehicle ;
    :description "Vehicle ahead in tunnel" .

:fogObstacle a :RoadObject ;
    :description "Fog reducing visibility in tunnel" .

:fogEvidence a :FallingObjectIndicator ;
    :description "Fog density reducing visibility range" ;
    :indicatesPotentialRisk :occlusionRisk .

:laneIntrusionRisk a :LaneIntrusionRisk ;
    :description "Vehicle ahead may drift into lane due to poor visibility" ;
    :hasSeverityScore :sev1 ;
    :confidenceScore "0.75"^^xsd:float .

:occlusionRisk a :OcclusionRisk ;
    :description "Fog obscures vehicle ahead, increasing collision risk" ;
    :hasSeverityScore :sev2 ;
    :confidenceScore "0.85"^^xsd:float .

:foggyCondition a :FoggyCondition ;
    :description "Heavy fog in tunnel" .

:sev1 a :SeverityScore ;
    :severityValue "0.70"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.80"^^xsd:float .
```

