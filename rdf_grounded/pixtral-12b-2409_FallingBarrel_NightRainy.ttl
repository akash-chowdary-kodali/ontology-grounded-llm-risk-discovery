@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Nighttime Pedestrian Near Parked Vehicle with Road Obstacles" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasActor :actor1, :actor2 ;
    :hasObstacle :obstacle1, :obstacle2 ;
    :hasEvidence :evidence1 ;
    :hasRisk :risk1, :risk2, :risk3 ;
