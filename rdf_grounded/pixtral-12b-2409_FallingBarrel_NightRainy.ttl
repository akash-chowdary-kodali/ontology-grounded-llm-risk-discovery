    :description "Fallen tree branch obstructing road" ;
    :indicatesPotentialRisk :risk1 .

:weather1 a :NightCondition .

:risk1 a :OcclusionRisk ;
    :description "Fallen tree branch partially blocking road visibility" ;
    :hasSeverityScore :sev1 .

:risk2 a :PedestrianCollisionRisk ;
    :description "Pedestrian standing too close to moving traffic path" ;
    :hasSeverityScore :sev2 .

:risk3 a :LaneIntrusionRisk ;
    :description "Vehicle parked in non-standard position near road hazard" ;
    :hasSeverityScore :sev3 .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .

:sev2 a :SeverityScore ;
