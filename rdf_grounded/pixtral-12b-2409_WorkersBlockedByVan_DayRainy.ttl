@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "UrbanFogWithPedestrianAndObstacles" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasActor :actor1, :actor2 ;
    :hasObstacle :obstacle1, :obstacle2 ;
    :hasWeatherCondition :weather1 ;
    :hasEvidence :evidence1, :evidence2 ;
    :hasRisk :risk1, :risk2, :risk3 .

:actor1 a :Pedestrian ;
    :description "Pedestrian pushing heavy object on sidewalk" .
:actor2 a :Pedestrian ;
    :description "Pedestrian crossing road in fog" .

:obstacle1 a :RoadObject ;
    :description "Large concrete barrier on sidewalk" .
:obstacle2 a :RoadObject ;
    :description "Orange traffic cones on road" .

:weather1 a :FoggyCondition ;
    :description "Heavy fog reducing visibility" .

:evidence1 a :FallingObjectIndicator ;
    :description "Heavy object being pushed by pedestrian" ;
    :indicatesPotentialRisk :risk1 .
:evidence2 a :RollingBallIndicator ;
    :description "Orange cones indicating potential rolling hazard" ;
    :indicatesPotentialRisk :risk2 .

:risk1 a :CollisionRisk ;
    :description "Risk of collision with pedestrian pushing heavy object" ;
    :hasSeverityScore :sev1 .
:risk2 a :OcclusionRisk ;
    :description "Risk of occlusion due to fog and objects" ;
    :hasSeverityScore :sev2 .
:risk3 a :PedestrianCollisionRisk ;
    :description "Pedestrian crossing road in low-visibility conditions" ;
    :hasSeverityScore :sev3 .

:sev1 a :SeverityScore ;
    :severityValue "0.9"^^xsd:float .
:sev2 a :SeverityScore ;
    :severityValue "0.8"^^xsd:float .
:sev3 a :SeverityScore ;
    :severityValue "0.95"^^xsd:float .
```

