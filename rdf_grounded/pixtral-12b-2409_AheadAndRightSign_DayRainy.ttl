@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "FoggyUrbanIntersection" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1, :risk2, :risk3 ;
    :hasObstacle :obstacle1 .

:weather1 a :FoggyCondition .

:risk1 a :OcclusionRisk ;
    :description "Reduced visibility due to fog obscuring road and actors" ;
    :hasSeverityScore :sev1 .

:risk2 a :RoadConditionRisk ;
    :description "Potentially slippery road conditions due to wet surface" ;
    :hasSeverityScore :sev2 .

:risk3 a :WeatherRisk ;
    :description "Foggy conditions reducing overall visibility and reaction time" ;
    :hasSeverityScore :sev3 .

:obstacle1 a :RoadObject ;
    :description "Fog obscuring visibility of potential actors and objects" .

:sev1 a :SeverityScore ;
    :severityValue "0.9"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:sev3 a :SeverityScore ;
    :severityValue "0.85"^^xsd:float .
```

