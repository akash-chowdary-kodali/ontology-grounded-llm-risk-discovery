```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Foggy scene with potential obstacles" ;
    :hasCornerCaseType :cc1 .

:cc1 a :BehaviorAnomaly ;
    :hasActor :actor1 ;
    :hasObstacle :obstacle1 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1 .

:actor1 a :Pedestrian .

:obstacle1 a :RoadObject ;
    :description "A cylindrical object rolling onto the roadway" .

:weather1 a :FoggyCondition .

:risk1 a :PedestrianCollisionRisk ;
    :description "Potential risk of pedestrian collision due to the rolling object" ;
    :hasSeverityScore :sev1 .

:sev1 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .
```

