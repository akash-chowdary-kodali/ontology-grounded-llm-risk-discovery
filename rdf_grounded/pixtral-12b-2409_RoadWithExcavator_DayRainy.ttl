**Scene Description in RDF Triples (Turtle Format)**
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "HeavyFogUrbanRoadScenario" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasWeatherCondition :foggyCondition ;
    :hasObstacle :orangeCone ;
    :hasRisk :risk1, :risk2 ;
    :hasEvidence :evidence1 .

:foggyCondition a :FoggyCondition ;
    :description "Severe fog reducing visibility to <10 meters" .

:orangeCone a :RoadObject ;
    :description "Orange traffic cone placed on right side of road" .

:evidence1 a :FallingObjectIndicator ;
    :description "Fog droplets accumulating on windshield, obscuring vision" ;
    :indicatesPotentialRisk :risk1 .

:risk1 a :OcclusionRisk ;
    :description "Heavy fog causing severe visual occlusion of road ahead" ;
    :hasSeverityScore :sev1 .

:sev1 a :SeverityScore ;
    :severityValue "0.92"^^xsd:float .

:risk2 a :RoadConditionRisk ;
    :description "Wet road surface combined with fog increases skid risk" ;
    :hasSeverityScore :sev2 .

:sev2 a :SeverityScore ;
    :severityValue "0.78"^^xsd:float .
```

