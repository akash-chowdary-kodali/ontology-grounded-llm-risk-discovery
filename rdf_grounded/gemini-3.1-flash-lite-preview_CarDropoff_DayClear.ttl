Scene Description in RDF Triples (Turtle Format)
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "ParkedVehicleObstruction" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasActor :vehicle1 ;
    :hasObstacle :roadObject1 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1 .

:vehicle1 a :Vehicle ;
    :description "Ambulance parked on the side of the road" .

:roadObject1 a :RoadObject ;
    :description "Parked vehicle obstructing lane" .

:weather1 a :ClearCondition, :DayCondition .

:risk1 a :LaneIntrusionRisk ;
    :description "Parked vehicle encroaching into the driving lane, forcing potential lane change or stop" ;
    :hasSeverityScore :sev1 ;
    :confidenceScore "0.85"^^xsd:float .

:sev1 a :SeverityScore ;
    :severityValue "0.65"^^xsd:float .

