### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Nighttime Parking Lot with Flooded Road" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasObstacle :roadObject1 ;
    :hasWeatherCondition :nightCondition ;
    :hasRisk :roadConditionRisk1, :occlusionRisk1 .

:roadObject1 a :RoadObject ;
    :description "Flooded road surface with standing water" .

:nightCondition a :NightCondition ;
    :description "Dark nighttime environment with limited visibility" .

:roadConditionRisk1 a :RoadConditionRisk ;
    :description "Hydroplaning risk due to flooded road surface" ;
    :hasSeverityScore :sev1 .

:occlusionRisk1 a :OcclusionRisk ;
    :description "Limited visibility of parked vehicle due to water reflections and nighttime" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:vehicle1 a :Vehicle ;
    :description "Parked vehicle partially submerged in water" .

:evidence1 a :FallingObjectIndicator ;
    :description "Water puddles acting as reflective surfaces" ;
    :indicatesPotentialRisk :occlusionRisk1 .

:cc1 :hasEvidence :evidence1 .
```

