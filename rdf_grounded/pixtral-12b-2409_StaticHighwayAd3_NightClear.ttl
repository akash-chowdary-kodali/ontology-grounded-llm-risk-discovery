    :hasSeverityScore :sev2 .

:weather1 a :NightCondition ;
    :description "Low-light conditions affecting visibility of signs and road markings" .

:sev1 a :SeverityScore ;
    :severityValue "0.65"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.70"^^xsd:float .

:billboard1 a :Billboard ;
    :description "Electronic billboard displaying dynamic traffic information (e.g., speed limit changes)" .

:trafficSign1 a :TrafficSign ;
