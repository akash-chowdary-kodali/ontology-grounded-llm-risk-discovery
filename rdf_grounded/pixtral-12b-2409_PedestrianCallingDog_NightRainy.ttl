:actor2 a :Pedestrian ;
    :description "Dog running across road from right side" .

:obstacle1 a :RoadObject ;
    :description "Wet road surface with reflective sheen" .

:weather1 a :NightCondition ;
    :description "Dark urban street with artificial lighting" .

:evidence1 a :RollingBallIndicator ;
    :description "Dogs' movement suggests dynamic obstacle crossing" ;
    :indicatesPotentialRisk :risk1 .

:risk1 a :PedestrianCollisionRisk ;
    :description "Dogs crossing road in front of vehicle" ;
    :hasSeverityScore :sev1 .

:risk2 a :OcclusionRisk ;
    :description "Low visibility due to nighttime and wet road reflections" ;
    :hasSeverityScore :sev2 .

:risk3 a :RoadConditionRisk ;
    :description "Slippery road conditions due to wet surface" ;
    :hasSeverityScore :sev3 .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

:sev3 a :SeverityScore ;
    :severityValue "0.60"^^xsd:float .
