```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Pedestrians on Road at Night" ;
    :hasCornerCaseType :cc1 .

:cc1 a :BehaviorAnomaly ;
    :hasActor :actor1 ;
    :hasActor :actor2 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1 ;
    :hasRisk :risk2 .

:actor1 a :Pedestrian ;
    :description "Child running on the road" .

:actor2 a :Pedestrian ;
    :description "Adult running on the road" .

:weather1 a :NightCondition ;
    :hasSeverityScore :sev1 .

:risk1 a :PedestrianCollisionRisk ;
    :description "High risk of collision with pedestrians on the road" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
    :severityValue "0.9"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.85"^^xsd:float .

:risk2 a :RoadConditionRisk ;
    :description "Wet road due to rain, increasing slippery conditions" ;
    :hasSeverityScore :sev3 .

:sev3 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .
```

Identified Risks for each risk class
