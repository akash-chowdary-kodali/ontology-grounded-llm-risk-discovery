:risk2 a :RoadConditionRisk ;
    :description "Slippery road conditions due to heavy rain" ;
    :hasSeverityScore :sev2 .

:sev2 a :SeverityScore ;
    :severityValue "0.8"^^xsd:float .

:trafficLight1 a :TrafficLight ;
    :description "Traffic light partially obscured by rain" .

:trafficSign1 a :TrafficSign ;
