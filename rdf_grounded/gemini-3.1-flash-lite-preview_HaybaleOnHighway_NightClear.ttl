Scene Description in RDF Triples (Turtle Format)
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "FallingHayBaleNight" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasObstacle :haybale1 ;
    :hasWeatherCondition :night1 ;
    :hasEvidence :fallingObject1 ;
    :hasRisk :risk1 ;
    :occursInScene :scene1 .

:haybale1 a :RoadObject ;
    :description "Hay bale falling across the road" .

:night1 a :NightCondition .

:fallingObject1 a :FallingObjectIndicator ;
    :indicatesPotentialRisk :risk1 .

:risk1 a :CollisionRisk ;
    :description "High speed impact risk with falling object on road" ;
    :hasSeverityScore :sev1 .

:sev1 a :SeverityScore ;
    :severityValue "0.95"^^xsd:float .

