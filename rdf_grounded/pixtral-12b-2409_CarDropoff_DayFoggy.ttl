### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "FoggyUrbanIntersection" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasWeatherCondition :foggyCondition ;
    :hasRisk :risk1, :risk2 ;
    :hasObstacle :vehicle1, :vehicle2 ;
    :description "Heavy fog reduces visibility in urban intersection" .

:foggyCondition a :FoggyCondition .

:vehicle1 a :Vehicle ;
    :description "Vehicle ahead in foggy conditions" .
:vehicle2 a :Vehicle ;
    :description "Vehicle on right lane, partially visible" .

:risk1 a :OcclusionRisk ;
    :description "Reduced visibility due to fog obscures other vehicles and pedestrians" ;
    :hasSeverityScore :sev1 ;
    :confidenceScore "0.92"^^xsd:float .

:risk2 a :WeatherRisk ;
    :description "Foggy conditions increase risk of collision due to limited visibility" ;
    :hasSeverityScore :sev2 ;
    :confidenceScore "0.88"^^xsd:float .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.85"^^xsd:float .
```

