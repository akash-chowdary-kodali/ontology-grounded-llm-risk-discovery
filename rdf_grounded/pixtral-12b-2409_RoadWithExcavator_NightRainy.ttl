:evidence1 a :RollingBallIndicator ;
    :description "Traffic cone indicates potential lane obstruction" ;
    :indicatesPotentialRisk :risk1 .

:weather1 a :NightCondition ;
    :description "Low-light conditions in tunnel/underpass" .

:risk1 a :LaneIntrusionRisk ;
    :description "Traffic cone obstructing lane, potential collision with vehicle" ;
    :hasSeverityScore :sev1 .

:risk2 a :OcclusionRisk ;
    :description "Limited visibility due to nighttime and tunnel structure" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
