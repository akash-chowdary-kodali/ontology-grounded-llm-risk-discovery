### Scene Description in RDF Triples (Turtle Format)
```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "FoggyRoadWithUnusualActors" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasActor :actor1, :actor2 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1, :risk2 ;
    :hasEvidence :evidence1 .

:actor1 a :Pedestrian ;
    :description "Dog crossing road in fog" .

:actor2 a :Obstacle ;
    :description "Large elephant statue on roadside" .

:weather1 a :FoggyCondition ;
    :description "Heavy fog reducing visibility" .

:evidence1 a :EvidenceIndicator ;
    :description "Fog obscuring visibility beyond 20 meters" ;
    :indicatesPotentialRisk :risk2 .

:risk1 a :PedestrianCollisionRisk ;
    :description "Dog crossing road in fog, potential collision with vehicle" ;
    :hasSeverityScore :sev1 .

:risk2 a :OcclusionRisk ;
    :description "Heavy fog obscuring road and potential hazards" ;
    :hasSeverityScore :sev2 .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.85"^^xsd:float .
```

