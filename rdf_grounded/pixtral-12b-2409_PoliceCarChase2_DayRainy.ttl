    :description "Reduced visibility due to water spray obstructing view" ;
    :hasSeverityScore :sev1 .

:risk2 a :RoadConditionRisk ;
    :description "Slippery road conditions due to water accumulation" ;
    :hasSeverityScore :sev2 .

