:scene1 a :Scene ;
    :scenarioName "FoggyUrbanDriving" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1, :risk2, :risk3 ;
    :hasObstacle :obstacle1 .

:weather1 a :FoggyCondition .

:obstacle1 a :RoadObject ;
    :description "Reduced visibility due to fog" .

:risk1 a :OcclusionRisk ;
    :description "Reduced visibility of other vehicles and road features due to fog" ;
    :hasSeverityScore :sev1 .

:risk2 a :WeatherRisk ;
    :description "Foggy conditions affecting driving safety" ;
    :hasSeverityScore :sev2 .

:risk3 a :CollisionRisk ;
    :description "Potential collision risk due to limited visibility of other vehicles" ;
    :hasSeverityScore :sev3 .

:sev1 a :SeverityScore ;
    :severityValue "0.9"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.85"^^xsd:float .

:sev3 a :SeverityScore ;
    :severityValue "0.8"^^xsd:float .

:actor1 a :Vehicle ;
    :description "Vehicle in front of the autonomous vehicle" .

:actor2 a :Vehicle ;
    :description "Vehicle on the right lane" .
```

Identified Risks for each risk class:

**Risk 1:**
