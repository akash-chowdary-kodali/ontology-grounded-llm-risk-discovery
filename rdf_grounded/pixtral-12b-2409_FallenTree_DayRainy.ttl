```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "HeavyRainUrbanTraffic" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1, :risk2, :risk3 ;
    :hasEvidence :evidence1 .

:weather1 a :RainyCondition .

:evidence1 a :RollingBallIndicator ;
    :description "Water accumulation on road causing reduced traction" ;
    :indicatesPotentialRisk :risk3 .

:risk1 a :RearEndCollisionRisk ;
    :description "High density of vehicles in rainy conditions increases rear-end collision risk" ;
    :hasSeverityScore :sev1 .

:risk2 a :RoadConditionRisk ;
    :description "Slippery road surface due to heavy rain" ;
    :hasSeverityScore :sev2 .

:risk3 a :OcclusionRisk ;
    :description "Reduced visibility due to rain and water splashes" ;
    :hasSeverityScore :sev3 .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .

:sev2 a :SeverityScore ;
    :severityValue "0.85"^^xsd:float .

:sev3 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .
