```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Vehicle obstruction in tunnel" ;
    :hasCornerCaseType :cc1 .

:cc1 a :BehaviorAnomaly ;
    :hasActor :actor1 ;
    :hasWeatherCondition :weather1 ;
    :hasObstacle :obstacle1 ;
    :hasRisk :risk1 .

:actor1 a :Vehicle .

:weather1 a :ClearCondition .

:obstacle1 a :RoadObject .

:risk1 a :RearEndCollisionRisk ;
    :description "Vehicle blockage could lead to a rear-end collision" ;
    :hasSeverityScore :sev1 .

:sev1 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .
