Scene Description in RDF Triples (Turtle Format)
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "VehicleLossOfControlTunnel" ;
    :hasCornerCaseType :cc1 .

:cc1 a :BehaviorAnomaly ;
    :occursInScene :scene1 ;
    :hasActor :vehicle1 ;
    :hasWeatherCondition :clear1 ;
    :hasRisk :risk1 .

:vehicle1 a :Vehicle ;
    :description "Vehicle losing control and swerving across lanes in tunnel" .

:clear1 a :ClearCondition .

:risk1 a :LaneIntrusionRisk ;
    :description "Vehicle swerving into ego-vehicle path causing potential lane intrusion" ;
    :hasSeverityScore :sev1 ;
    :confidenceScore "0.95"^^xsd:float .

:sev1 a :SeverityScore ;
    :severityValue "0.80"^^xsd:float .

