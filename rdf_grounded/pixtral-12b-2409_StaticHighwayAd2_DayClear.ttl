    :scenarioName "UrbanIntersectionWithBillboards" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :description "Traffic light showing red with no visible pedestrians or vehicles crossing" ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1, :risk2 ;
    :hasObstacle :billboard1, :trafficSign1 .

:weather1 a :DayCondition ;
    :description "Clear daytime with good visibility" .

:risk1 a :DistractionRisk ;
    :description "Billboards may distract driver attention" ;
    :hasSeverityScore :sev1 .

:risk2 a :OcclusionRisk ;
    :description "Billboards partially obstruct view of traffic signs" ;
    :hasSeverityScore :sev2 .

:billboard1 a :Billboard ;
    :description "Large advertisement billboard on left side of intersection" .

:trafficSign1 a :TrafficSign ;
    :description "No entry traffic sign partially obscured by billboard" .

:sev1 a :SeverityScore ;
    :severityValue "0.45"^^xsd:float .

:sev2 a :SeverityScore ;
