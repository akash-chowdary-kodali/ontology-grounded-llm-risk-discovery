Scene Description in RDF Triples (Turtle Format)
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "NighttimeTrafficLightAmbiguity" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasWeatherCondition :night1 ;
    :hasRisk :risk1 .

:night1 a :NightCondition .

:risk1 a :DistractionRisk ;
    :description "Billboard containing traffic light imagery may cause driver distraction or confusion with actual traffic signals" ;
    :hasSeverityScore :sev1 ;
    :confidenceScore "0.75"^^xsd:float .

:sev1 a :SeverityScore ;
    :severityValue "0.45"^^xsd:float .

