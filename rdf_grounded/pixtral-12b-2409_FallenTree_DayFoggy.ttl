    :hasWeatherCondition :foggyCondition ;
    :hasObstacle :vehicleObstacle1, :vehicleObstacle2 ;
    :hasRisk :occlusionRisk1, :rearEndCollisionRisk1 ;
    :hasEvidence :evidence1 .

