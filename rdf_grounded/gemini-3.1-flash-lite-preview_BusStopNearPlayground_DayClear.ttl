Scene Description in RDF Triples (Turtle Format)
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "PedestrianCrossingIntersection" ;
    :hasCornerCaseType :cc1 .

:cc1 a :BehaviorAnomaly ;
    :occursInScene :scene1 ;
    :hasActor :pedestrian1, :pedestrian2 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1 .

:pedestrian1 a :Pedestrian .
:pedestrian2 a :Pedestrian .
:weather1 a :ClearCondition ;
    :description "Bright daylight with clear visibility" .

:risk1 a :PedestrianCollisionRisk ;
    :description "Pedestrians running across the road in front of the vehicle" ;
    :hasSeverityScore :sev1 ;
    :confidenceScore "0.95"^^xsd:float .

:sev1 a :SeverityScore ;
    :severityValue "0.92"^^xsd:float .

