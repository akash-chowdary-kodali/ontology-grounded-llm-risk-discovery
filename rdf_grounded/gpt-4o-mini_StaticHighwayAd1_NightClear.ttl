```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "NighttimeRoadScene" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1 .

:weather1 a :NightCondition .

:risk1 a :DistractionRisk ;
    :description "Low visibility due to nighttime conditions" ;
    :hasSeverityScore :sev1 .

:sev1 a :SeverityScore ;
    :severityValue "0.70"^^xsd:float .

:risk2 a :CollisionRisk ;
    :description "Potential collision with an unseen obstacle" ;
    :hasSeverityScore :sev2 .

:sev2 a :SeverityScore ;
    :severityValue "0.80"^^xsd:float .

:risk3 a :OcclusionRisk ;
    :description "Obscured view due to nighttime conditions" ;
    :hasSeverityScore :sev3 .

:sev3 a :SeverityScore ;
    :severityValue "0.65"^^xsd:float .
```

