Scene Description in RDF Triples (Turtle Format)
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "FoggyCityFollowing" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasActor :vehicle1 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1 .

:vehicle1 a :Vehicle .

:weather1 a :FoggyCondition .

:risk1 a :RearEndCollisionRisk ;
    :description "Vehicle following too closely in low visibility fog" ;
    :confidenceScore "0.95"^^xsd:float ;
    :hasSeverityScore :sev1 .

:sev1 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .

