```turtle
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "Rainy condition with a vehicle in the intersection" ;
    :hasCornerCaseType :cc1 .

:cc1 a :StateAnomaly ;
    :hasActor :actor1 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1 ;
    :hasObstacle :obstacle1 .

:actor1 a :Vehicle .

:weather1 a :RainyCondition .

:obstacle1 a :RoadObject ;
    :description "Standing water on the road due to rain" .

:risk1 a :CollisionRisk ;
    :description "Potential collision due to reduced visibility and wet conditions" ;
    :hasSeverityScore :sev1 .

:sev1 a :SeverityScore ;
    :severityValue "0.75"^^xsd:float .
```

