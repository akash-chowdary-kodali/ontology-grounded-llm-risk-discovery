:scene1 a :Scene ;
    :scenarioName "Nighttime Urban Road with Rolling Ball Indicator" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasEvidence :evidence1 ;
    :hasObstacle :obstacle1 ;
    :hasRisk :risk1, :risk2 ;
