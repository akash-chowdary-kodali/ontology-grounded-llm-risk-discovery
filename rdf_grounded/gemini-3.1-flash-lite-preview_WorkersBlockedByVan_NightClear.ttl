Scene Description in RDF Triples (Turtle Format)
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "PedestrianCrossingRoadWork" ;
    :hasCornerCaseType :cc1 .

:cc1 a :BehaviorAnomaly ;
    :hasActor :pedestrian1 ;
    :hasWeatherCondition :night1 ;
    :hasRisk :risk1 .

:pedestrian1 a :Pedestrian .
:night1 a :NightCondition .

:risk1 a :PedestrianCollisionRisk ;
    :description "Pedestrian walking across the road in the path of the vehicle near construction obstacles" ;
    :confidenceScore "0.95"^^xsd:float ;
    :hasSeverityScore :sev1 .

:sev1 a :SeverityScore ;
    :severityValue "0.90"^^xsd:float .

