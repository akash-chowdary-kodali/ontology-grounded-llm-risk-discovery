Scene Description in RDF Triples (Turtle Format)
@prefix : <http://cecs571.csulb.edu/ontology/cornercase#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:scene1 a :Scene ;
    :scenarioName "FallingBillboardOnRoad" ;
    :hasCornerCaseType :cc1 .

:cc1 a :EvidenceBasedAnomaly ;
    :hasEvidence :indicator1 ;
    :hasObstacle :billboard1 ;
    :hasWeatherCondition :weather1 ;
    :hasRisk :risk1 .

:indicator1 a :FallingObjectIndicator ;
    :indicatesPotentialRisk :risk1 .

:billboard1 a :Billboard .

:weather1 a :ClearCondition ;
    :description "Bright daylight with clear visibility" .

:risk1 a :CollisionRisk ;
    :description "Billboard falling onto the vehicle path" ;
    :hasSeverityScore :sev1 ;
    :confidenceScore "0.95"^^xsd:float .

:sev1 a :SeverityScore ;
    :severityValue "0.95"^^xsd:float .

